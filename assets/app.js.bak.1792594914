function cambiarTabVoz(tab) {
    ['single', 'batch', 'history'].forEach(t => {
        document.getElementById('voz-tab-' + t).style.display = (t === tab) ? 'block' : 'none';
    });
    if (tab === 'history') cargarHistorial();
}

async function generarVozStudio() {
    const texto = document.getElementById('voz-texto').value;
    const dictRaw = document.getElementById('voz-dict').value;
    const dict = {};
    dictRaw.split(',').forEach(pair => {
        const [k, v] = pair.split('=');
        if (k && v) dict[k.trim()] = v.trim();
    });
    const payload = {
        texto, diccionario: dict,
        voz: document.getElementById('voz-modelo').value,
        preset: document.getElementById('voz-preset').value,
        formato: document.getElementById('voz-formato').value,
        pitch: parseInt(document.getElementById('voz-pitch').value),
        velocidad: parseFloat(document.getElementById('voz-speed').value),
        distorsion: parseInt(document.getElementById('voz-dist').value),
        reverb: parseInt(document.getElementById('voz-rev').value),
        bass: parseInt(document.getElementById('voz-bass').value),
        treble: parseInt(document.getElementById('voz-treble').value),
        compresor: document.getElementById('voz-compresor').checked,
        normalizar: document.getElementById('voz-normalizar').checked
    };
    const out = document.getElementById('voz-resultado');
    out.innerHTML = '<p style="color:#feca57;">⏳ Generando...</p>';
    const r = await fetch('/api/voice_studio', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)});
    const data = await r.json();
    if (data.status === 'ok') {
        out.innerHTML = `<div style="background:#0a2a2a; padding:10px; border-radius:8px; margin-top:10px;">
            <audio controls src="${data.url}" style="width:100%;"></audio>
            <p style="color:#00ffcc; font-size:12px; margin:4px 0;">${data.duracion}s · ${payload.formato.toUpperCase()}</p>
        </div>`;
    } else { out.innerHTML = `<p style="color:#ff6b6b;">❌ ${data.error}</p>`; }
}

async function generarBatch() {
    const lineas = document.getElementById('voz-batch-textos').value.split('\n').filter(l => l.trim());
    if (!lineas.length) return alert('Pega al menos una línea');
    const out = document.getElementById('batch-resultado');
    out.innerHTML = `<p style="color:#feca57;">⏳ Generando ${lineas.length} audios (paciencia)...</p>`;
    const r = await fetch('/api/voice_studio', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({
        batch: lineas, voz: document.getElementById('voz-modelo').value,
        preset: document.getElementById('voz-preset').value, formato: document.getElementById('voz-formato').value
    })});
    const data = await r.json();
    if (data.status === 'ok') {
        out.innerHTML = data.resultados.map(res => 
            `<div style="background:#111; padding:8px; border-radius:6px; margin-bottom:8px;">
                <audio controls src="${res.url}" style="width:100%; height:30px;"></audio>
            </div>`
        ).join('');
    }
}

async function cargarHistorial() {
    const r = await fetch('/api/historial');
    const data = await r.json();
    const out = document.getElementById('lista-historial');
    if (!data.historial.length) { out.innerHTML = '<p style="color:#888;">Sin audios.</p>'; return; }
    out.innerHTML = data.historial.map(h => 
        `<div style="background:#111; padding:10px; border-radius:6px; margin-bottom:8px; border:1px solid #222;">
            <div style="display:flex; justify-content:space-between;">
                <span style="font-size:12px; color:#00ffcc;">${h.nombre}</span>
                <span style="font-size:10px; color:#888;">${new Date(h.ts*1000).toLocaleTimeString()}</span>
            </div>
            <audio controls src="${h.url}" style="width:100%; height:30px; margin-top:4px;"></audio>
        </div>`
    ).join('');
}

async function borrarHistorial() {
