function toggleConversacion() {
    modoConversacion = !modoConversacion;
    const btn = document.getElementById('btn-conversacion');
    const btnDict = document.getElementById('btn-dictado');
    
    if (modoConversacion) {
        btn.style.background = '#00ffcc';
        btn.style.color = '#000';
        btn.innerText = '⏹';
        if (btnDict) btnDict.disabled = true;
        iniciarEscuchaConversacion();
    } else {
        btn.style.background = '#222';
        btn.style.color = '#fff';
        btn.innerText = '🎧';
        if (recognizer) { try { recognizer.stop(); } catch(e){} }
        window.speechSynthesis.cancel();
        if (btnDict) btnDict.disabled = false;
    }
}

function iniciarEscuchaConversacion() {
    if (!modoConversacion) return;
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) { _jarvisLog("Tu navegador no soporta microfono."); return; }
    
    recognizer = new SR();
    recognizer.lang = 'es-ES';
    recognizer.interimResults = false;
    recognizer.maxAlternatives = 1;

    const btn = document.getElementById('btn-conversacion');
    if (btn) btn.innerText = '🔴';

    recognizer.onstart = function() {
        _jarvisLog('Micro ACTIVO - habla ahora');
        if (btn) btn.innerText = '🔴';
    };

    recognizer.onresult = function(event) {
        const texto = event.results[0][0].transcript;
        _jarvisLog('Capturado: ' + texto);
        const input = document.getElementById('chat-input');
        input.disabled = false;
        input.value = texto;
        if (btn) btn.innerText = '⏳';
        setTimeout(() => {
            _jarvisLog('Enviando chat...');
            try { enviarChat(); } catch(e) { _jarvisLog('ERROR: ' + e.message); }
        }, 400);
    };

    recognizer.onerror = function(event) {
        _jarvisLog('Error micro: ' + event.error);
        if (btn) btn.innerText = '🔴';
        if (modoConversacion) setTimeout(iniciarEscuchaConversacion, 1500);
    };

    recognizer.onend = function() {
        if (modoConversacion) {
            // Si seguimos en modo conversacion y no estamos generando, re-escuchar
            if (btn) btn.innerText = '🔴';
        }
    };

    try { recognizer.start(); } catch(e) { _jarvisLog('No se pudo iniciar: ' + e.message); }
}

function hablar(texto) {
    if (!('speechSynthesis' in window)) {
        alert("Tu navegador no soporta Text-to-Speech.");
        return;
    }
    // Cancelar cualquier audio en curso
    window.speechSynthesis.cancel();
    
    // Limpiar texto (quitar HTML y bloques de codigo para que no lea símbolos raros)
    const cleanText = texto.replace(/<[^>]*>?/gm, '').replace(/```[\s\S]*?```/g, ' [bloque de codigo omitido] ');
    
    const utterance = new SpeechSynthesisUtterance(cleanText);
    utterance.lang = 'es-ES';
    utterance.rate = 1.1; // Un poco mas rapido de lo normal
    utterance.pitch = 1.0;
    
    // Buscar una voz en espanol si esta disponible
    const voices = window.speechSynthesis.getVoices();
    const esVoice = voices.find(v => v.lang.startsWith('es'));
    if (esVoice) utterance.voice = esVoice;
    
    utterance.onend = function() {
        if (modoConversacion) {
            // Pequena pausa para no cortar el final del audio
            setTimeout(iniciarEscuchaConversacion, 500);
        }
    };
    window.speechSynthesis.speak(utterance);
}


async function generarVozStudio() {
    const texto = document.getElementById('voz-texto').value.trim();
    const voz = document.getElementById('voz-modelo').value;
    const pitch = parseInt(document.getElementById('voz-pitch').value);
    const velocidad = parseFloat(document.getElementById('voz-speed').value);
    const out = document.getElementById('voz-resultado');
    
    if (!texto) { out.innerHTML = '<p style="color:#ff6b6b;">Escribe un texto primero.</p>'; return; }
    
    out.innerHTML = '<p style="color:#feca57;">⏳ Generando voz (esto tarda 20-40s)...</p>';
    
    try {
        const r = await fetch('/api/voice_studio', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({texto, voz, pitch, velocidad})
        });
        const data = await r.json();
        
        if (r.ok) {
            out.innerHTML = `
                <p style="color:#00ffcc;">✅ Audio generado (${data.duracion}s) - Voz: ${data.voz} | Pitch: ${data.pitch} | Velocidad: ${data.velocidad}x</p>
                <audio controls src="${data.audio_url}" style="width:100%; margin-top:8px;"></audio>
            `;
        } else {
            out.innerHTML = `<p style="color:#ff6b6b;">❌ Error: ${data.error}</p>`;
        }
    } catch(e) {
        out.innerHTML = `<p style="color:#ff6b6b;">❌ Error de red: ${e}</p>`;
    }
}


// ═══ VOICE STUDIO PRO ═══
let _ultimoAudioId = null;

async function cargarVocesDisponibles() {
    try {
        const r = await fetch('/api/voces_disponibles');
        const data = await r.json();
        const sel = document.getElementById('voz-modelo');
        sel.innerHTML = '';
        data.voces.forEach(v => {
            const opt = document.createElement('option');
            opt.value = v.id;
            opt.innerText = v.nombre + (v.instalada ? '' : ' (no instalada)');
            opt.disabled = !v.instalada;
            sel.appendChild(opt);
        });
    } catch(e) { console.error(e); }
}

async function abrirCatalogoVoces() {
    const modal = document.getElementById('modal-voces');
    const lista = document.getElementById('lista-voces');
    modal.style.display = 'block';
    lista.innerHTML = '<p style="color:#feca57;">Cargando catálogo...</p>';
    try {
        const r = await fetch('/api/voces_disponibles');
        const data = await r.json();
        lista.innerHTML = '';
        data.voces.forEach(v => {
            const div = document.createElement('div');
            div.style.cssText = 'padding:12px; background:#1a1a1a; border-radius:8px; margin-bottom:8px; border:1px solid #222;';
            div.innerHTML = `
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <b style="color:#fff;">${v.nombre}</b><br>
                        <span style="font-size:11px; color:#888;">${v.idioma} · ${v.licencia} · Calidad: ${v.calidad}</span>
                    </div>
                    <div style="display:flex; gap:6px;">
                        ${v.instalada 
                            ? `<button onclick="desinstalarVoz('${v.id}')" style="background:#ff6b6b; color:#fff; border:none; border-radius:6px; padding:6px 12px; cursor:pointer; font-size:12px;">🗑️ Borrar</button>`
                            : `<button onclick="instalarVoz('${v.id}')" style="background:#00ffcc; color:#000; border:none; border-radius:6px; padding:6px 12px; cursor:pointer; font-size:12px;">⬇️ Instalar</button>`
                        }
                    </div>
                </div>
            `;
            lista.appendChild(div);
        });
    } catch(e) { lista.innerHTML = `<p style="color:#ff6b6b;">Error: ${e}</p>`; }
}

function cerrarCatalogoVoces() {
    document.getElementById('modal-voces').style.display = 'none';
}

async function instalarVoz(vozId) {
    if (!confirm(`¿Instalar la voz ${vozId}? (descarga ~80MB)`)) return;
    try {
        const r = await fetch('/api/instalar_voz', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({voz: vozId})
        });
        const data = await r.json();
        if (r.ok) {
            alert('✅ ' + data.mensaje);
            await cargarVocesDisponibles();
            await abrirCatalogoVoces();
        } else {
            alert('❌ ' + data.error);
        }
    } catch(e) { alert('Error: ' + e); }
}

async function generarVozStudio() {
    const texto = document.getElementById('voz-texto').value.trim();
    const voz = document.getElementById('voz-modelo').value;
    const pitch = parseInt(document.getElementById('voz-pitch').value);
    const velocidad = parseFloat(document.getElementById('voz-speed').value);
    const distorsion = parseInt(document.getElementById('voz-dist').value);
    const reverb = parseInt(document.getElementById('voz-rev').value);
    const bass = parseInt(document.getElementById('voz-bass').value);
    const treble = parseInt(document.getElementById('voz-treble').value);
    const compresor = document.getElementById('voz-compresor').checked;
    const normalizar = document.getElementById('voz-normalizar').checked;
    const out = document.getElementById('voz-resultado');

    if (!texto) { out.innerHTML = '<p style="color:#ff6b6b;">Escribe un texto primero.</p>'; return; }
    out.innerHTML = '<p style="color:#feca57;">⏳ Generando audio con efectos (esto tarda 20-40s)...</p>';

    try {
        const r = await fetch('/api/voice_studio', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({texto, voz, pitch, velocidad, distorsion, reverb, bass, treble, compresor, normalizar})
        });
        const data = await r.json();
        if (r.ok) {
            _ultimoAudioId = data.audio_id;
            out.innerHTML = `
                <div style="background:#0a2a2a; padding:12px; border-radius:8px; border:1px solid #00ffcc;">
                    <p style="color:#00ffcc; margin-top:0;">✅ Audio generado (${data.duracion}s) — ${data.voz} | Pitch: ${data.pitch} | Vel: ${data.velocidad}x</p>
                    <audio controls src="${data.audio_url}" style="width:100%; margin-bottom:8px;"></audio>
                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                        <button onclick="guardarAudioStudio()" style="background:#00ffcc; color:#000; border:none; border-radius:6px; padding:8px 14px; cursor:pointer; font-weight:bold;">💾 Guardar Audio</button>
                        <button onclick="guardarVozDios()" style="background:#feca57; color:#000; border:none; border-radius:6px; padding:8px 14px; cursor:pointer; font-weight:bold;">🤖 Usar Voz del Dios</button>
                    </div>
                    <p style="font-size:11px; color:#888; margin-bottom:0;">⚠️ Se borrará automáticamente en 10 minutos si no lo guardas.</p>
                </div>
            `;
        } else {
            out.innerHTML = `<p style="color:#ff6b6b;">❌ Error: ${data.error}</p>`;
        }
    } catch(e) { out.innerHTML = `<p style="color:#ff6b6b;">❌ Error de red: ${e}</p>`; }
}

async function guardarAudioStudio() {
    if (!_ultimoAudioId) return;
    const nombre = prompt('Nombre para el audio:', 'audio_' + Date.now());
    if (!nombre) return;
    try {
        const r = await fetch('/api/guardar_audio', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({audio_id: _ultimoAudioId, nombre})
        });
        const data = await r.json();
        if (r.ok) { alert('✅ Guardado en: ' + data.ruta); }
        else { alert('❌ ' + data.error); }
    } catch(e) { alert('Error: ' + e); }
}

