
// ═══ PERSISTENCIA DE CHAT (Fase 2) ═══
function guardarMensajeLocal(rol, texto) {
    let historial = JSON.parse(localStorage.getItem('chat_history') || '[]');
    historial.push({ rol: rol, texto: texto, ts: Date.now() });
    // Mantener solo los ultimos 50 mensajes
    if (historial.length > 50) historial = historial.slice(historial.length - 50);
    localStorage.setItem('chat_history', JSON.stringify(historial));
}

function renderizarBurbuja(rol, texto) {
    const box = document.getElementById('chat-messages');
    const msg = document.createElement('div');
    msg.className = 'msg ' + (rol === 'user' ? 'user' : 'assistant');
    
    if (rol === 'user') {
        msg.innerText = texto;
    } else {
        const uid = 'audio_' + Math.random().toString(36).substr(2, 9);
        msg.innerHTML = `
            <div id="texto-${uid}" style="background: rgba(0,255,204,0.1); border-left: 3px solid #00ffcc; padding: 8px; border-radius: 4px; font-family: monospace; white-space: pre-wrap;">${texto}</div>
            <div style="display:flex; align-items:center; gap:10px; margin-top:8px; background:#111; padding:6px 12px; border-radius:20px; border:1px solid #333;">
                <button id="btn-${uid}" onclick="togglePlayTTS('${uid}')" style="background:#00ffcc; color:#000; border:none; border-radius:50%; width:34px; height:34px; cursor:pointer; font-size:16px; display:flex; align-items:center; justify-content:center;">▶️</button>
                <input type="range" id="slider-${uid}" min="0" max="100" value="0" style="flex:1; height:6px; accent-color:#00ffcc;" disabled>
                <span id="time-${uid}" style="color:#888; font-size:12px; min-width:36px; text-align:right; font-family:monospace;">0:00</span>
            </div>
        `;
    }
    box.appendChild(msg);
    box.scrollTop = box.scrollHeight;
}

function cargarHistorialLocal() {
    const historial = JSON.parse(localStorage.getItem('chat_history') || '[]');
    const box = document.getElementById('chat-messages');
    box.innerHTML = '';
    if (historial.length === 0) {
        box.innerHTML = '<div class="msg assistant">Sistema listo.<br>Memoria conectada.<br>¿Qué necesitas, Arquitecto?</div>';
    } else {
        historial.forEach(m => renderizarBurbuja(m.rol, m.texto));
    }
}
// ═══ FIN PERSISTENCIA ═══
let dictadoActivo = false;

// ═══ LOG VISIBLE (debug Jarvis) ═══
function _jarvisLog(msg) {
    console.log('[Jarvis]', msg);
    const consoleDiv = document.getElementById('log-console');
    if (consoleDiv) {
        const line = document.createElement('div');
        line.innerText = '> ' + msg;
        line.style.color = '#00ffcc'; // Color de acento
        consoleDiv.appendChild(line);
        consoleDiv.scrollTop = consoleDiv.scrollHeight;
    }
}
// ═══ FIN LOG ═══

let modoConversacion = false;
let recognizer = null;

let tareasInterval;

function toggleMenu() {
  document.getElementById('sidebar').classList.toggle('open');
  document.querySelector('.overlay').classList.toggle('open');
}

function nav(vista, el) {
    if (vista === 'produccion') setTimeout(cargarTareasVideo, 300);
    return _nav_orig(vista, el);
}
function _nav_orig(viewId, el) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('view-' + viewId).classList.add('active');
  if (el) el.classList.add('active');
  toggleMenu();
  
  // Cerrar sidebar solo si estaba abierto (no reabrir al navegar)
  const _sb = document.getElementById('sidebar');
  if (_sb && _sb.classList.contains('open')) toggleMenu();

  if(viewId === 'chat') { setTimeout(() => document.getElementById('chat-input').focus(), 100); }
  if(viewId === 'docs') { cargarDoc(document.getElementById('doc-selector').value); }
  if(viewId === 'media') { loadMedia(); }
  if(viewId === 'analytics') { loadAnalytics(); }
  if(viewId === 'musica') { document.getElementById('music-url').value = localStorage.getItem('kaggle_url') || ''; }
  if(viewId === 'imagen') { /* Sin estado previo por ahora */ }
  if(viewId === 'produccion') { loadTareas(); clearInterval(tareasInterval); tareasInterval = setInterval(loadTareas, 3000); }
  else { clearInterval(tareasInterval); }
}

async function enviarChat() {
  if (modoConversacion && recognizer) {
      try { recognizer.stop(); } catch(e){}
  }
  const input = document.getElementById('chat-input');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  input.disabled = true;

  const box = document.getElementById('chat-messages');
  const userMsg = document.createElement('div');
  userMsg.className = 'msg user'; userMsg.innerText = text;
  box.appendChild(userMsg);

  const botMsg = document.createElement('div');
  botMsg.className = 'msg assistant';
  guardarMensajeLocal('user', text);
  botMsg.innerHTML = '<div class="typing-indicator"><span></span><span></span><span></span></div>';
  box.appendChild(botMsg);
  box.scrollTop = box.scrollHeight;

  try {
    const res = await fetch('/api/chat', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({mensaje: text}),
    });
    const data = await res.json();

    if (data.status === 'processing') {
      const taskId = data.task_id;
      const consoleDiv = document.getElementById('log-console');
      consoleDiv.classList.add('active');
      consoleDiv.innerHTML = '<div style="color:#00ffcc; margin-bottom:5px;">[Conectando con el Dios...]</div>';
      
      localStorage.setItem('pending_task', taskId);
      const eventSource = new EventSource('/api/chat_stream/' + taskId);
      let fullLog = "";
      let logQueue = []; // Cola para ir pintando poco a poco
      let pintando = false;

      // Función para pintar logs con retardo (efecto máquina de escribir)
      const procesarCola = () => {
          if (pintando || logQueue.length === 0) return;
          pintando = true;
          const linea = logQueue.shift();
          // Añadimos la línea al div de la consola
          const p = document.createElement('div');
          p.innerText = linea;
          p.style.opacity = '0.8';
          p.style.fontSize = '12px';
          consoleDiv.appendChild(p);
          consoleDiv.scrollTop = consoleDiv.scrollHeight;
          box.scrollTop = box.scrollHeight;
          
          setTimeout(() => {
              pintando = false;
              procesarCola();
          }, 30); // 30ms entre líneas (se puede ajustar)
      };

      eventSource.onmessage = function(e) {
          const chunk = JSON.parse(e.data);
          fullLog += chunk + "\n";
          
          logQueue.push(chunk);
          procesarCola();

          if (chunk.includes("[+] Proceso finalizado.") || chunk.includes("[+] Error:")) {
              eventSource.close();
              
              // Esperar a que la cola termine de pintarse antes de cerrar
              const checkQueue = setInterval(() => {
                  if (logQueue.length === 0 && !pintando) {
                      clearInterval(checkQueue);
                      consoleDiv.classList.remove('active');

                      let respuesta = fullLog;
                      if (respuesta.includes("[dios] Tarea completada. Resumen:")) {
                          respuesta = respuesta.split("[dios] Tarea completada. Resumen:")[1].trim();
                      } else if (respuesta.includes("[dios] Tarea completada.")) {
                          respuesta = respuesta.split("[dios] Tarea completada.")[1].trim();
                      } else if (respuesta.includes("Error LLM:")) {
                          respuesta = "❌ Error: " + respuesta.split("Error LLM:")[1].trim();
                      } else {
                          respuesta = respuesta.split('\n').slice(-10).join('\n');
                      }

                      // Formatear la respuesta final para que sea legible
                                            // ¿Fue un proceso real (agent) o una charla?
                      const esProcesoReal = fullLog.includes("[dios] Paso ") || fullLog.includes("[dios] Modo AGENTE");
                      
                      // LIMPIAR mensajes internos del log
                      respuesta = respuesta
                          .replace(/\[\+\] Proceso finalizado\.?/g, '')
                          .replace(/\[\+\] Iniciando el Dios\.\.\./g, '')
                          .replace(/\[dios\] Paso \d+\/\d+/g, '')
                          .replace(/\[dios\] Tarea completada\. Resumen:/g, '')
                          .replace(/\[dios\] Tarea completada\./g, '')
                          .trim();
                      if (!respuesta) respuesta = '(Sin respuesta)';
                      
                      // Anadir marca de proceso finalizado SOLO si fue un agente real
                      if (esProcesoReal) {
                          respuesta = respuesta + '\n\n✅ Proceso de producción finalizado.';
                      }
                      localStorage.removeItem('pending_task');
                      guardarMensajeLocal('assistant', respuesta);

                      // Formatear la respuesta final con barra de audio
                      const uid = 'audio_' + Math.random().toString(36).substr(2, 9);
                      botMsg.innerHTML = `
                          <div id="texto-${uid}" style="background: rgba(0,255,204,0.1); border-left: 3px solid #00ffcc; padding: 8px; border-radius: 4px; font-family: monospace; white-space: pre-wrap;">${respuesta}</div>
                          <div style="display:flex; align-items:center; gap:10px; margin-top:8px; background:#111; padding:6px 12px; border-radius:20px; border:1px solid #333;">
                              <button id="btn-${uid}" onclick="togglePlayTTS('${uid}')" style="background:#00ffcc; color:#000; border:none; border-radius:50%; width:34px; height:34px; cursor:pointer; font-size:16px; display:flex; align-items:center; justify-content:center;">▶️</button>
                              <input type="range" id="slider-${uid}" min="0" max="100" value="0" style="flex:1; height:6px; accent-color:#00ffcc;" disabled>
                              <span id="time-${uid}" style="color:#888; font-size:12px; min-width:36px; text-align:right; font-family:monospace;">0:00</span>
                          </div>
                      `;
                      if (modoConversacion) {
                          setTimeout(() => togglePlayTTS(uid), 500);
                      }
                      input.disabled = false;
                      input.focus();
                      input.focus();
                  }
              }, 100);
          }
      };

      eventSource.onerror = function() {
          eventSource.close();
          consoleDiv.classList.remove('active');
          botMsg.innerText = "❌ Error de conexión SSE.";
          input.disabled = false;
      };
    } else {
      botMsg.innerText = "❌ Error: " + (data.mensaje || 'Desconocido');
      input.disabled = false;
    }
  } catch (e) {
    botMsg.innerText = "❌ Error de red: " + e;
    input.disabled = false;
  }
}

async function crearCanal() {
  const nombre = document.getElementById('canal-nombre').value.trim();
  const nicho = document.getElementById('canal-nicho').value.trim();
  const rpm = document.getElementById('canal-rpm').value.trim();
  const log = document.getElementById('log-canal');
  if (!nombre || !nicho || !rpm) { log.style.display='block'; log.innerText = "Rellena todos los campos."; return; }
  
  log.style.display='block';
  log.innerText = "Creando canal...";
  try {
    const res = await fetch('/api/crear_canal', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({nombre, nicho, rpm}),
    });
    const data = await res.json();
    log.innerText = JSON.stringify(data, null, 2);
  } catch (e) { log.innerText = "Error de red: " + e; }
}

async function cargarDoc(filename) {
  const box = document.getElementById('doc-content');
  box.innerText = "Cargando " + filename + "...";
  try {
    const res = await fetch('/api/docs?file=' + encodeURIComponent(filename));
    if (!res.ok) throw new Error("HTTP " + res.status);
    const text = await res.text();
    box.innerText = text;
  } catch (e) {
    box.innerText = "❌ Error al cargar el documento: " + e.message;
  }
}

async function guardarNota() {
  const archivo = document.getElementById('doc-target').value;
  const texto = document.getElementById('doc-note').value.trim();
  if(!texto) return;
  
  const btn = event.target;
  btn.disabled = true;
  btn.innerText = "Guardando...";
  
  try {
    const res = await fetch('/api/documentar', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({archivo, texto})
    });
    const data = await res.json();
    alert(data.reply);
    document.getElementById('doc-note').value = '';
    cargarDoc(document.getElementById('doc-selector').value);
  } catch(e) {
    alert("Error: " + e);
  }
  btn.disabled = false;
  btn.innerText = "Guardar Aprendizaje";
}

async function loadMedia() {
  try {
    const res = await fetch('/api/media');
    const data = await res.json();
    const renderList = (items, listId, playerId, type) => {
      const list = document.getElementById(listId);
      list.innerHTML = '';
      if(!items || items.length === 0) { list.innerHTML = '<li>Sin archivos</li>'; return; }
      items.forEach(f => {
        const li = document.createElement('li');
        li.innerText = f;
        li.onclick = () => {
          const p = document.getElementById(playerId);
          p.innerHTML = '';
          if(type === 'audio') { const a = document.createElement('audio'); a.controls = true; a.src = '/media/' + f; p.appendChild(a); }
          if(type === 'video') { const v = document.createElement('video'); v.controls = true; v.src = '/media/' + f; p.appendChild(v); }
          if(type === 'image') { const i = document.createElement('img'); i.src = '/media/' + f; p.appendChild(i); }
        };
        list.appendChild(li);
      });
    };
    renderList(data.audio, 'list-audio', 'player-audio', 'audio');
    renderList(data.video, 'list-video', 'player-video', 'video');
    renderList(data.image, 'list-image', 'player-image', 'image');
  } catch(e) { console.error(e); }
}

async function loadAnalytics() {
  const c = document.getElementById('analytics-container');
  if (!c) return;
  c.innerHTML = 'Cargando métricas...';
  try {
    const res = await fetch('/api/analytics');
    const data = await res.json();
    
    let html = '';
    html += `<div class="yt-header">▶️ ${data["nombre_canal"] || "YouTube Studio"}</div>`;
    html += `<div class="kpi-grid">`;
    html += `<div class="kpi-card"><div class="kpi-label">Suscriptores</div><div class="kpi-value">${data["Suscriptores YT"] || 0}</div><div class="kpi-sub">↑ En crecimiento</div></div>`;
    html += `<div class="kpi-card"><div class="kpi-label">Visitas Totales</div><div class="kpi-value">${data["Visitas YT"] || 0}</div><div class="kpi-sub">↑ En crecimiento</div></div>`;
    html += `<div class="kpi-card"><div class="kpi-label">Vídeos Publicados</div><div class="kpi-value">${data["Vídeos YT"] || 0}</div></div>`;
    html += `</div>`;

    const videos = data["Ultimos Videos"] || [];
    if (videos.length > 0) {
      html += `<div class="video-list">`;
      videos.forEach(title => {
        html += `<div class="video-item">
          <div class="video-thumb"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
          <div class="video-info"><div class="video-title">${title}</div><div class="video-meta">Recién subido • Público</div></div>
        </div>`;
      });
      html += `</div>`;
    }

    html += `<div class="yt-header" style="margin-top:10px;">💻 Estado del Sistema</div>`;
    html += `<div class="sys-grid">`;
    html += `<div class="sys-card"><div class="sys-label">Repo</div><div class="sys-value">${data["Tamaño Repo (MB)"] || 0} MB</div></div>`;
    html += `<div class="sys-card"><div class="sys-label">Archivos .py</div><div class="sys-value">${data["Archivos Python"] || 0}</div></div>`;
    html += `<div class="sys-card"><div class="sys-label">Memoria IA</div><div class="sys-value">${data["Conversaciones Dios"] || 0}</div></div>`;
    html += `<div class="sys-card"><div class="sys-label">Kaggle</div><div class="sys-value kaggle">${data["Estado Kaggle"] || 'Off'}</div></div>`;
    html += `</div>`;

    c.innerHTML = html;
    const oldTitle = c.previousElementSibling;
    if(oldTitle && oldTitle.tagName === 'H2') oldTitle.style.display = 'none';
  } catch(e) { c.innerHTML = "❌ Error cargando analytics: " + e; }
}

async 
async function generarMusicaACEStep() {
  const prompt = document.getElementById('music-prompt').value.trim();
  const duracion = parseInt(document.getElementById('music-duracion').value) || 30;
  const log = document.getElementById('music-log');
  if (!prompt) { alert("Rellena el prompt"); return; }

  log.style.display = 'block';
  log.innerText = "Enviando petición...\nCompilación en Kaggle (~30 min). Sé paciente.";
  try {
    const r = await fetch('/api/generar_musica_acestep', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({prompt, duracion})
    });
    const data = await r.json();
    log.innerText += "\n" + (data.reply || data.mensaje || JSON.stringify(data));

    if (data.status === 'ok' && data.reply) {
      const taskId = data.reply.match(/Tarea (\w+)/);
      if (taskId) {
        log.innerText += "\nEsperando resultado...";
        const interval = setInterval(async () => {
          const rs = await fetch('/api/tareas');
          const tareas = await rs.json();
          const t = tareas.find(x => x.id === taskId[1]);
          if (t) {
            log.innerText = `Estado: ${t.estado} (${t.progreso}%)\n${t.mensaje}`;
            if (t.estado === 'completado' || t.estado === 'error') {
              clearInterval(interval);
              if (t.estado === 'completado') {
                setTimeout(() => location.reload(), 2000);
              }
            }
          }
        }, 15000);
      }
    }
  } catch(e) {
    log.innerText += "\nERROR: " + e.message;
  }
}

function generarMusica() {
  const url = document.getElementById('music-url').value.trim();
  const prompt = document.getElementById('music-prompt').value.trim();
  const log = document.getElementById('music-log');
  if(!url || !prompt) { alert("Rellena ambos campos"); return; }
  
  localStorage.setItem('kaggle_url', url);
  log.style.display = 'block';
  log.innerText = "Iniciando generación en Kaggle...\nLa GPU tardará 2-5 min. Por favor, espera.";
  
  try {
    const res = await fetch('/api/generar_musica', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({url, prompt})
    });
    const data = await res.json();
    log.innerText = data.reply;
    if(data.status === 'ok') {
      setTimeout(() => { nav('produccion', document.querySelector('.nav-item:nth-child(5)')); }, 1500);
    }
  } catch(e) { log.innerText = "Error de conexión: " + e; }
}

async function loadTareas() {
  const container = document.getElementById('tareas-container');
  if (!container) return;
  try {
    const res = await fetch('/api/tareas');
    const tareas = await res.json();
    if (!tareas || tareas.length === 0) { container.innerHTML = '<p style="color: var(--muted);">No hay tareas en cola.</p>'; return; }
    let html = '';
    tareas.reverse().forEach(t => {
      let color = t.estado === 'completado' ? '#10b981' : (t.estado === 'error' ? '#ef4444' : '#3b82f6');
      let icono = t.estado === 'completado' ? '✅' : (t.estado === 'error' ? '❌' : '⏳');
      html += `<div class="card" style="padding: 16px; border-left: 4px solid ${color};">
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
          <strong style="font-size: 0.9em;">${icono} ${t.tipo.toUpperCase()} (${t.id})</strong>
          <span style="font-size: 0.75em; color: var(--muted);">${t.estado.toUpperCase()}</span>
        </div>
        <p style="font-size: 0.85em; margin-bottom: 12px; color: var(--muted);">"${t.prompt}"</p>
        <div style="width: 100%; background: #000; height: 6px; border-radius: 3px; overflow: hidden; margin-bottom: 8px;">
          <div style="width: ${t.progreso}%; background: ${color}; height: 100%; transition: width 0.5s;"></div>
        </div>
        <div style="font-size: 0.75em; color: var(--muted);">${t.mensaje}</div>
      </div>`;
    });
    container.innerHTML = html;
  } catch(e) { console.error(e); }
}

async function mejorarPrompt() {
  const input = document.getElementById('prompt-input').value.trim();
  const out = document.getElementById('prompt-output');
  if(!input) return;
  out.style.display = 'block';
  out.innerText = "Expandiendo idea...";
  try {
    const tipo = document.getElementById('prompt-type').value;
    const res = await fetch('/api/prompt', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({prompt: input, tipo: tipo})
    });
    const data = await res.json();
    out.innerText = data.status === 'ok' ? data.reply : "Error: " + data.mensaje;
  } catch(e) { out.innerText = "Error de red"; }
}

function cambiarTema(tema) {
  const root = document.documentElement;
  if (tema === 'light') {
    root.style.setProperty('--bg', '#f4f4f5'); root.style.setProperty('--surface', '#ffffff');
    root.style.setProperty('--border', '#e4e4e7'); root.style.setProperty('--text', '#18181b');
    root.style.setProperty('--muted', '#71717a'); root.style.setProperty('--bubble-bot', '#e4e4e7');
  } else if (tema === 'midnight') {
    root.style.setProperty('--bg', '#0f172a'); root.style.setProperty('--surface', '#1e293b');
    root.style.setProperty('--border', '#334155'); root.style.setProperty('--text', '#f8fafc');
    root.style.setProperty('--muted', '#94a3b8'); root.style.setProperty('--bubble-bot', '#334155');
  } else {
    root.style.setProperty('--bg', '#000000'); root.style.setProperty('--surface', '#121212');
    root.style.setProperty('--border', '#27272a'); root.style.setProperty('--text', '#ffffff');
    root.style.setProperty('--muted', '#a1a1aa'); root.style.setProperty('--bubble-bot', '#1f1f22');
  }
  localStorage.setItem('keiz-theme', tema);
}

window.onload = () => {
  const savedTheme = localStorage.getItem('keiz-theme') || 'dark';
  const themeSelect = document.getElementById('theme-select');
  if (themeSelect) themeSelect.value = savedTheme;
  cambiarTema(savedTheme);
};

async function generarImagen() {
  const prompt = document.getElementById('imagen-prompt').value.trim();
  const log = document.getElementById('imagen-log');
  
  if (!prompt) {
    alert("Escribe un prompt primero.");
    return;
  }
  
  log.style.display = 'block';
  log.innerText = "Enviando petición a Cloudflare SDXL...\nEsto puede tardar 20-30 segundos.";
  
  try {
    const res = await fetch('/api/generar_imagen', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({prompt: prompt})
    });
    const data = await res.json();
    
    if (data.status === 'ok') {
      log.innerText = "✅ Imagen generada. Ve al Media Center para verla.\n\n" + (data.reply || '');
    } else {
      log.innerText = "❌ Error: " + (data.mensaje || 'Desconocido');
    }
  } catch (e) {
    log.innerText = "❌ Error de red: " + e;
  }
}

async function producirVideo() {
  const video = document.getElementById('prod-video').value.trim();
  const audio = document.getElementById('prod-audio').value.trim();
  const nombre = document.getElementById('prod-nombre').value.trim();
  const log = document.getElementById('prod-log');
  
  if (!video || !audio || !nombre) {
    alert("Rellena los 3 campos.");
    return;
  }
  
  log.style.display = 'block';
  log.innerText = "Enviando petición al Dios para producir el vídeo...";
  
  try {
    // Llamamos al Dios (que tiene la tool producir_video)
    const mensaje = `Produce el video final usando la herramienta producir_video con los siguientes datos: video_path="${video}", audio_path="${audio}", nombre_final="${nombre}"`;
    const res = await fetch('/api/chat', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({message: mensaje})
    });
    const data = await res.json();
    
    if (data.status === 'processing') {
      log.innerText = "⏳ El Dios está procesando la producción...";
      // Polling para ver el estado
      const taskId = data.task_id;
      let polling = setInterval(async () => {
        const sres = await fetch('/api/chat_status?task_id=' + taskId);
        const sdata = await sres.json();
        if (sdata.status === 'done') {
          clearInterval(polling);
          log.innerText = sdata.log.split("[dios] Tarea completada. Resumen:")[1] || sdata.log;
        }
      }, 2000);
    } else {
      log.innerText = "❌ Error: " + (data.mensaje || 'Desconocido');
    }
  } catch (e) {
    log.innerText = "❌ Error de red: " + e;
  }
}

async function generarVideo() {
    const url = document.getElementById('video-url').value.trim();
    const prompt = document.getElementById('video-prompt').value.trim();
    const status = document.getElementById('video-status');
    if (!url || !prompt) { status.innerText = "❌ Faltan la URL o el prompt."; return; }
    status.innerHTML = "⏳ Conectando con Kaggle... (esto tarda)";
    try {
        const res = await fetch('/api/generar_video', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ url, prompt })
        });
        const data = await res.json();
        if (res.ok) status.innerHTML = `✅ ${data.mensaje}`;
        else status.innerHTML = `❌ Error: ${data.error}`;
    } catch (e) { status.innerHTML = `❌ Error de red: ${e}`; }
}


function dictar() {
    const btn = document.getElementById('btn-dictado');
    const input = document.getElementById('chat-input');
    if (!input) return;

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
        alert("Tu navegador no soporta dictado por voz. Prueba con Chrome.");
        return;
    }

    const recognition = new SpeechRecognition();
    recognition.lang = 'es-ES';
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;

    if (btn) btn.innerText = '🔴';

    recognition.onresult = function(event) {
        const texto = event.results[0][0].transcript;
        _jarvisLog('Dictado: ' + texto);
        input.disabled = false;
        input.value = texto;
        if (btn) btn.innerText = '🎙️';
        setTimeout(() => {
            _jarvisLog('Enviando chat...');
            try { enviarChat(); } catch(e) { _jarvisLog('ERROR: ' + e.message); }
        }, 400);
    };

    recognition.onerror = function(event) {
        console.error("Error dictado:", event.error);
        if (btn) btn.innerText = '🎙️';
    };

    recognition.onend = function() {
        if (btn) btn.innerText = '🎙️';
    };

    recognition.start();
}


