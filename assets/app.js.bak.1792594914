async function desinstalarVoz(vozId) {
    if (!confirm(`¿Seguro que quieres borrar la voz "${vozId}"? Liberaras espacio.`)) return;
    try {
        const r = await fetch('/api/desinstalar_voz', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({voz: vozId})
        });
        const data = await r.json();
        if (r.ok) {
            alert('✅ ' + data.mensaje);
            await cargarVocesDisponibles();
            await abrirCatalogoVoces();
        } else {
            alert('❌ ' + data.error);
        }
    } catch(e) { alert('Error: ' + e); }
}


// ═══ CONTROLES TTS PRO (Chunks) ═══
let currentTTS = {
    chunks: [], idx: 0, utterance: null, btn: null, slider: null, timeLabel: null,
    interval: null, startTime: 0, totalDuration: 0, isPaused: false, isPlaying: false, uid: null
};

function togglePlayTTS(uid) {
    const btn = document.getElementById(`btn-${uid}`);
    const slider = document.getElementById(`slider-${uid}`);
    const timeLabel = document.getElementById(`time-${uid}`);
    const textoDiv = document.getElementById(`texto-${uid}`);
    if (!('speechSynthesis' in window)) return alert("Tu navegador no soporta TTS.");
    const texto = textoDiv ? textoDiv.innerText : '';
    if (!texto) return;

    if (currentTTS.uid === uid && currentTTS.isPaused) {
        _reanudarTTS();
        return;
    }
    if (currentTTS.uid === uid && currentTTS.isPlaying) {
        _pausarTTS();
        return;
    }
    _iniciarNuevoTTS(uid, texto, btn, slider, timeLabel);
}

function _splitChunks(texto) {
    const limpio = texto.replace(/<[^>]*>?/gm, '').trim();
    if (!limpio) return [];
    const chunks = limpio.match(/[^.!?]+[.!?]+|[^.!?]+$/g) || [limpio];
    return chunks.map(c => c.trim()).filter(c => c.length > 0);
}

function _iniciarNuevoTTS(uid, texto, btn, slider, timeLabel) {
    window.speechSynthesis.cancel();
    if (currentTTS.interval) clearInterval(currentTTS.interval);
    const chunks = _splitChunks(texto);
    if (chunks.length === 0) return;
    const palabras = texto.split(/\s+/).length;
    const duracionTotal = (palabras / 150) * 60;
    currentTTS = {
        chunks: chunks, idx: 0, utterance: null, btn: btn, slider: slider, timeLabel: timeLabel,
        interval: null, startTime: 0, totalDuration: duracionTotal, isPaused: false, isPlaying: true, uid: uid
    };
    btn.innerText = '⏸️';
    _reproducirChunk();
}

function _reproducirChunk() {
    if (currentTTS.idx >= currentTTS.chunks.length) {
        _terminarTTS();
        return;
    }
    const chunk = currentTTS.chunks[currentTTS.idx];
    const utterance = new SpeechSynthesisUtterance(chunk);
    utterance.lang = 'es-ES';
    utterance.rate = 1.1;
    const voices = window.speechSynthesis.getVoices();
    const esVoice = voices.find(v => v.lang.startsWith('es'));
    if (esVoice) utterance.voice = esVoice;

    utterance.onstart = () => {
        currentTTS.startTime = Date.now();
        if (currentTTS.btn) currentTTS.btn.innerText = '⏸️';
        _iniciarIntervalTTS();
    };

    utterance.onend = () => {
        if (!currentTTS.isPlaying) return;
        currentTTS.idx++;
        _actualizarBarraTTS();
        _reproducirChunk();
    };

    utterance.onerror = () => {
        if (!currentTTS.isPlaying) return;
        currentTTS.idx++;
        _actualizarBarraTTS();
        _reproducirChunk();
    };

    currentTTS.utterance = utterance;
    window.speechSynthesis.speak(utterance);
}

function _pausarTTS() {
    currentTTS.isPlaying = false;
    currentTTS.isPaused = true;
    window.speechSynthesis.cancel();
    if (currentTTS.interval) clearInterval(currentTTS.interval);
    if (currentTTS.btn) currentTTS.btn.innerText = '▶️';
    _actualizarBarraTTS();
}

function _reanudarTTS() {
    currentTTS.isPlaying = true;
    currentTTS.isPaused = false;
    if (currentTTS.btn) currentTTS.btn.innerText = '⏸️';
    _reproducirChunk();
}

function _terminarTTS() {
    if (currentTTS.interval) clearInterval(currentTTS.interval);
    if (currentTTS.btn) currentTTS.btn.innerText = '▶️';
    if (currentTTS.slider) currentTTS.slider.value = 100;
    if (currentTTS.timeLabel) currentTTS.timeLabel.innerText = _formatTime(currentTTS.totalDuration);
    currentTTS.isPlaying = false;
    currentTTS.isPaused = false;
    if (modoConversacion) {
        setTimeout(iniciarEscuchaConversacion, 500);
    }
}

function _iniciarIntervalTTS() {
    if (currentTTS.interval) clearInterval(currentTTS.interval);
    currentTTS.interval = setInterval(() => {
        if (!currentTTS.isPlaying) return;
        _actualizarBarraTTS();
    }, 250);
}

function _actualizarBarraTTS() {
    if (!currentTTS.slider || !currentTTS.chunks || !currentTTS.chunks.length) return;
    const basePercent = (currentTTS.idx / currentTTS.chunks.length) * 100;
    currentTTS.slider.value = Math.min(basePercent, 99);
    if (currentTTS.timeLabel && currentTTS.totalDuration) {
        const transcurrido = (currentTTS.idx / currentTTS.chunks.length) * currentTTS.totalDuration;
        currentTTS.timeLabel.innerText = _formatTime(transcurrido);
    }
}

function _formatTime(secs) {
    const m = Math.floor(secs / 60);
    const s = Math.floor(secs % 60);
    return m + ':' + s.toString().padStart(2, '0');
}
// ═══ FIN CONTROLES TTS PRO ═══

// ═══ RECONEXION AL CARGAR ═══
document.addEventListener('DOMContentLoaded', () => {
    cargarHistorialLocal();
    
    // ¿Hay un proceso en marcha?
    const pendingTask = localStorage.getItem('pending_task');
    if (pendingTask) {
        console.log('[Reconexion] Proceso pendiente detectado:', pendingTask);
        const box = document.getElementById('chat-messages');
        const botMsg = document.createElement('div');
        botMsg.className = 'msg assistant';
        botMsg.innerHTML = '<div class="typing-indicator"><span></span><span></span><span></span></div><br><small style="color:#feca57;">⏳ Reconectando al proceso en curso...</small>';
        box.appendChild(botMsg);
        box.scrollTop = box.scrollHeight;
        
        // Llamar a la funcion que reconecta al SSE
        reconectarAlProceso(pendingTask, botMsg);
    }
});

async function reconectarAlProceso(taskId, botMsg) {
    const input = document.getElementById('chat-input');
    input.disabled = true;
    const consoleDiv = document.getElementById('log-console');
    consoleDiv.classList.add('active');
    consoleDiv.innerText = "Reconectando al Dios...\n";
    
    const eventSource = new EventSource('/api/chat_stream/' + taskId);
    let fullLog = "";
    
    eventSource.onmessage = function(e) {
        const chunk = JSON.parse(e.data);
        fullLog += chunk + "\n";
        consoleDiv.innerText = fullLog;
        consoleDiv.scrollTop = consoleDiv.scrollHeight;
        
        if (chunk.includes("[+] Proceso finalizado.") || chunk.includes("[+] Error:")) {
            eventSource.close();
            consoleDiv.classList.remove('active');
            localStorage.removeItem('pending_task');
            
            let respuesta = fullLog;
            if (respuesta.includes("[dios] Tarea completada. Resumen:")) {
                respuesta = respuesta.split("[dios] Tarea completada. Resumen:")[1].trim();
            } else if (respuesta.includes("[dios] Tarea completada.")) {
                respuesta = respuesta.split("[dios] Tarea completada.")[1].trim();
            }
            
            // Limpieza condicional
            const esProcesoReal = fullLog.includes("[dios] Paso ") || fullLog.includes("[dios] Modo AGENTE");
            respuesta = respuesta.replace(/\[\+\] Proceso finalizado\.?/g, '').replace(/\[\+\] Iniciando el Dios\.\.\./g, '').replace(/\[dios\] Paso \d+\/\d+/g, '').replace(/\[dios\] Tarea completada\.( Resumen:)?/g, '').trim();
            if (esProcesoReal) respuesta = respuesta + '\n\n✅ Proceso de producción finalizado.';
            
            localStorage.removeItem('pending_task');
            guardarMensajeLocal('assistant', respuesta);
            
            // Reemplazar el mensaje de "reconectando" con el real
            botMsg.innerHTML = '';
            botMsg.remove();
            renderizarBurbuja('assistant', respuesta);
            
            input.disabled = false;
        }
    };
    
    eventSource.onerror = function() {
        eventSource.close();
        consoleDiv.classList.remove('active');
        botMsg.innerText = "❌ Error de reconexion.";
        input.disabled = false;
    };
}


async function cargarTareasVideo() {
    const cont = document.getElementById('tareas-video-container');
    if (!cont) return;
    try {
        const res = await fetch('/api/tareas_video');
        const tareas = await res.json();
        if (tareas.length === 0) {
            cont.innerHTML = '<p style="color:#888; font-size:13px;">No hay videos generados.</p>';
            return;
        }
        cont.innerHTML = tareas.map(t => {
            let video = '';
            if (t.ruta_video && t.ruta_video.includes('/')) {
                const name = t.ruta_video.split('/').pop();
                video = `<video controls src="/media/videos/${name}" style="width:100%; max-height:200px; border-radius:6px;"></video>`;
            }
            return `<div style="background:#111; padding:12px; border-radius:8px; border:1px solid #222;">
                <p style="color:#fff; font-size:13px; margin:0 0 6px;">${t.prompt}</p>
                <p style="color:#888; font-size:11px; margin:0 0 8px;">Estado: ${t.estado}</p>
                ${video}
            </div>`;
        }).join('');
    } catch(e) { console.error(e); }
}


// ═══ DASHBOARD ═══
async function cargarDashboard() {
  try {
    const r = await fetch('/api/dashboard');
    const d = await r.json();
    const s = d.salud || {};
    const icono = (v) => v === 'ok' || v === '?' ? '🟢' : '🔴';
    const set = (id, txt) => { const el = document.getElementById(id); if (el) el.textContent = txt; };
    set('dash-flask', icono(s.flask) + ' ' + (s.flask || '?'));
    set('dash-omni', icono(s.omniroute) + ' ' + (s.omniroute || '?'));
    set('dash-worker', icono(s.worker) + ' ' + (s.worker || '?'));
    set('dash-repo', s.repo || '?');
    const st = document.getElementById('dash-status');
    if (st) {
      const ok = s.flask === 'ok' && s.omniroute === 'ok' && s.worker === 'ok';
      st.textContent = ok ? '🟢 Sistema OK' : '🟡 Atención';
      st.style.background = ok ? 'rgba(34,197,94,0.15)' : 'rgba(234,179,8,0.15)';
      st.style.color = ok ? '#22c55e' : '#eab308';
    }
    const box = document.getElementById('dash-tareas');
    if (box) {
      if (!d.tareas || d.tareas.length === 0) {
        box.innerHTML = '<p class="dash-muted">Sin tareas recientes</p>';
      } else {
        box.innerHTML = d.tareas.map(t => {
          const id = (t.id || '?').substring(0, 8);
          const msg = (t.mensaje || t.prompt || '').substring(0, 55);
          const est = t.estado || '?';
          return '<div class="task-row"><span class="task-id">' + id + '</span><span>' + msg + '</span><span class="task-estado ' + est + '">' + est + '</span></div>';
        }).join('');
      }
    }
  } catch(e) { console.error('Dashboard:', e); }
}

async function apiDoctor() {
  mostrarToast('info', '🩺 Doctor', 'Diagnosticando...');
  try {
    const r = await fetch('/api/doctor', {method: 'POST'});
    const d = await r.json();
    mostrarToast(d.status === 'ok' ? 'success' : 'error', '🩺 Doctor', (d.reporte || d.mensaje || '').substring(0, 100));
    cargarDashboard();
  } catch(e) { mostrarToast('error', 'Doctor', String(e)); }
}

async function apiLimpiar() {
  mostrarToast('info', '🧹 Conserje', 'Consultando...');
  try {
    const r = await fetch('/api/conserje', {method: 'POST'});
    const d = await r.json();
    mostrarToast('success', '🧹 Conserje', (d.resumen || 'OK').substring(0, 120));
  } catch(e) { mostrarToast('error', 'Conserje', String(e)); }
}

// ═══ TOASTS ═══
function mostrarToast(tipo, titulo, mensaje) {
  const c = document.getElementById('toast-container');
  if (!c) return;
  const t = document.createElement('div');
  t.className = 'toast ' + tipo;
  t.innerHTML = '<div class="toast-title">' + titulo + '</div><div class="toast-msg">' + mensaje + '</div>';
  c.appendChild(t);
  setTimeout(() => { t.style.opacity = '0'; t.style.transition = 'opacity 0.3s'; setTimeout(() => t.remove(), 300); }, 5000);
}

// ═══ POLLING TOASTS ═══
let _tareasVistas = new Set();
let _pollInit = false;
async function initPolling() {
  if (_pollInit) return;
  _pollInit = true;
  try {
    const r = await fetch('/api/toasts');
    const ts = await r.json();
    ts.forEach(t => _tareasVistas.add(t.id));
  } catch(e) {}
  setInterval(async () => {
    try {
      const r = await fetch('/api/toasts');
      const ts = await r.json();
      ts.forEach(t => {
        if (!_tareasVistas.has(t.id)) {
          _tareasVistas.add(t.id);
          const tipo = t.estado === 'done' ? 'success' : 'error';
          const ic = t.estado === 'done' ? '✅' : '❌';
          mostrarToast(tipo, ic + ' Tarea ' + t.id.substring(0,8), (t.prompt || '').substring(0, 60));
        }
      });
    } catch(e) {}
  }, 5000);
}

// ═══ COMMAND PALETTE ═══
const CMD_ITEMS = [
  {icon: '🏠', label: 'Ir a Inicio', action: () => nav('inicio', null)},
  {icon: '🤖', label: 'Abrir chat con Dios', action: () => nav('chat', null)},
  {icon: '🎵', label: 'Música Studio', action: () => nav('musica', null)},
  {icon: '🎨', label: 'Image Studio', action: () => nav('imagen', null)},
  {icon: '🎙️', label: 'Voice Studio', action: () => nav('voz', null)},
  {icon: '🎬', label: 'Video Studio', action: () => nav('video', null)},
  {icon: '🎞️', label: 'Media Center', action: () => nav('media', null)},
  {icon: '📋', label: 'Cola de producción', action: () => nav('produccion', null)},
  {icon: '🩺', label: 'Doctor (diagnóstico)', action: () => { nav('inicio', null); setTimeout(apiDoctor, 200); }},
  {icon: '🧹', label: 'Limpiar sistema (Conserje)', action: () => { nav('inicio', null); setTimeout(apiLimpiar, 200); }},
  {icon: '📰', label: 'RSS', action: () => nav('rss', null)},
  {icon: '📊', label: 'Analytics', action: () => nav('analytics', null)},
  {icon: '📚', label: 'Documentación', action: () => nav('docs', null)},
];

let _cmdFiltrados = CMD_ITEMS.slice();
let _cmdSel = 0;

function initCommandPalette() {
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); abrirCmd(); }
    if (e.key === 'Escape') cerrarCmd();
  });
}

function abrirCmd() {
  const p = document.getElementById('cmd-palette');
  if (!p) return;
  p.style.display = 'flex';
  const i = document.getElementById('cmd-input');
  if (i) { i.value = ''; i.focus(); }
  _cmdFiltrados = CMD_ITEMS.slice();
  _cmdSel = 0;
  renderCmd();
}

function cerrarCmd() {
  const p = document.getElementById('cmd-palette');
  if (p) p.style.display = 'none';
}

function filtrarCmd() {
  const q = (document.getElementById('cmd-input').value || '').toLowerCase();
  _cmdFiltrados = CMD_ITEMS.filter(c => c.label.toLowerCase().includes(q));
  _cmdSel = 0;
  renderCmd();
}

function renderCmd() {
  const b = document.getElementById('cmd-results');
  if (!b) return;
  b.innerHTML = _cmdFiltrados.map((c, i) =>
    '<div class="cmd-item' + (i === _cmdSel ? ' selected' : '') + '" onclick="ejecutarCmd(' + i + ')"><span class="cmd-icon">' + c.icon + '</span>' + c.label + '</div>'
  ).join('');
}

function cmdKeydown(e) {
  if (e.key === 'ArrowDown') { e.preventDefault(); _cmdSel = Math.min(_cmdSel + 1, _cmdFiltrados.length - 1); renderCmd(); }
  if (e.key === 'ArrowUp') { e.preventDefault(); _cmdSel = Math.max(_cmdSel - 1, 0); renderCmd(); }
  if (e.key === 'Enter') { e.preventDefault(); ejecutarCmd(_cmdSel); }
}

function ejecutarCmd(i) {
  if (_cmdFiltrados[i]) { _cmdFiltrados[i].action(); cerrarCmd(); }
}

// ═══ INIT ═══
document.addEventListener('DOMContentLoaded', () => {
  initCommandPalette();
  initPolling();
  setTimeout(cargarDashboard, 400);
});
setInterval(() => {
  const v = document.getElementById('view-inicio');
  if (v && v.classList.contains('active')) cargarDashboard();
}, 15000);
