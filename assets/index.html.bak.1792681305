<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<title>KEIZ OS</title>
<link rel="manifest" href="/assets/manifest.json">
<!-- Fuentes de lujo -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #000000;
  --surface: rgba(20, 20, 25, 0.6);
  --border: rgba(255, 255, 255, 0.1);
  --accent: #007aff; /* Azul Apple */
  --accent-glow: rgba(0, 122, 255, 0.6);
  --text: #ffffff;
  --muted: #8e8e93;
  --font-main: 'Outfit', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --radius: 20px;
  --transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
body {
  background-color: var(--bg); color: var(--text); font-family: var(--font-main);
  height: 100dvh; overflow: hidden; display: flex; flex-direction: column;
  position: relative; perspective: 1000px;
}

/* Fondo de Orbes de Luz (Estilo Apple Vision Pro) */
body::before {
  content: ''; position: fixed; inset: 0;
  background: 
    radial-gradient(circle at 15% 25%, rgba(0, 122, 255, 0.15), transparent 45%),
    radial-gradient(circle at 85% 75%, rgba(139, 92, 246, 0.15), transparent 45%),
    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.02), transparent 60%);
  z-index: -1; pointer-events: none;
  animation: pulseBg 10s infinite alternate;
}
@keyframes pulseBg { from { opacity: 0.6; } to { opacity: 1; } }

/* Header Flotante (Cristal) */
header {
  position: absolute; top: 20px; left: 20px; right: 20px; height: 70px;
  background: var(--surface); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--border); border-radius: var(--radius);
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 20px; z-index: 100; box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}
.logo-small { font-weight: 800; font-size: 1.3em; letter-spacing: -0.5px; display: flex; align-items: center; gap: 10px; }
.logo-small img { height: 32px; filter: drop-shadow(0 0 15px var(--accent-glow)); }
.menu-btn { font-size: 1.5em; cursor: pointer; color: var(--text); }

/* Sidebar (Menú Flotante Deslizante) */
.sidebar {
  position: fixed; top: 100px; left: -320px; width: 300px; height: calc(100dvh - 120px);
  background: var(--surface); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px);
  border: 1px solid var(--border); border-radius: var(--radius);
  transition: var(--transition); z-index: 99; padding: 20px 10px;
  overflow-y: auto; box-shadow: 20px 0 50px rgba(0,0,0,0.5);
}
.sidebar.open { left: 20px; }
.sidebar::-webkit-scrollbar { display: none; }
.nav-item {
  padding: 16px 20px; cursor: pointer; color: var(--muted); font-size: 1.05em;
  font-weight: 600; display: flex; align-items: center; gap: 16px;
  border-radius: 14px; transition: all 0.2s; margin-bottom: 4px;
}
.nav-item:hover, .nav-item.active { color: var(--text); background: rgba(255,255,255,0.08); }
.nav-item.active { background: var(--accent); color: #fff; box-shadow: 0 0 20px var(--accent-glow); }

.overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); opacity: 0; pointer-events: none; transition: 0.4s; z-index: 98; }
.overlay.open { opacity: 1; pointer-events: auto; }

/* Área de Contenido Principal */
.main { flex: 1; overflow-y: auto; padding: 110px 20px 40px 20px; z-index: 1; }
.main::-webkit-scrollbar { display: none; }
.view { display: none; padding-bottom: 40px; }
.view.active { display: block; animation: slideUp 0.5s cubic-bezier(0.25, 0.8, 0.25, 1); }
@keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

/* Tarjetas de Cristal (Glass Cards) */
.section {
  background: var(--surface); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border); border-radius: var(--radius);
  padding: 24px; margin-bottom: 20px; box-shadow: 0 8px 32px rgba(0,0,0,0.2);
  transition: transform 0.2s;
}
h2 { font-weight: 700; font-size: 1.5em; letter-spacing: -0.5px; margin-bottom: 16px; }
p.desc { color: var(--muted); font-size: 0.95em; line-height: 1.5; margin-bottom: 20px; }

/* Botones Premium */
.dash-btn {
  background: var(--accent); color: #fff; border: none; padding: 14px 24px;
  border-radius: 14px; font-weight: 700; font-family: var(--font-main); font-size: 1em;
  cursor: pointer; transition: all 0.3s; width: 100%; letter-spacing: 0.5px;
  box-shadow: 0 4px 15px rgba(0, 122, 255, 0.3);
}
.dash-btn:active { transform: scale(0.96); box-shadow: 0 2px 10px rgba(0, 122, 255, 0.2); }

/* Inputs de Lujo */
input, textarea, select {
  width: 100%; padding: 16px; background: rgba(0,0,0,0.4); border: 1px solid var(--border);
  border-radius: 14px; color: #fff; font-family: var(--font-main); font-size: 1em;
  outline: none; transition: border 0.3s; margin-bottom: 16px;
}
input:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 10px rgba(0,122,255,0.2); }

/* Chat UI */
.chat-container { display: flex; flex-direction: column; height: calc(100dvh - 180px); }
.chat-messages { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; padding-bottom: 20px; }
.chat-messages::-webkit-scrollbar { display: none; }
.msg { padding: 16px 20px; border-radius: 20px; max-width: 85%; font-size: 0.95em; line-height: 1.5; backdrop-filter: blur(10px); }
.msg.bot { background: var(--surface); border: 1px solid var(--border); align-self: flex-start; border-bottom-left-radius: 4px; }
.msg.user { background: var(--accent); align-self: flex-end; border-bottom-right-radius: 4px; box-shadow: 0 4px 15px rgba(0, 122, 255, 0.3); }
.chat-input-area { display: flex; gap: 12px; background: var(--surface); padding: 10px; border-radius: 20px; border: 1px solid var(--border); }
.chat-input-area input { margin-bottom: 0; background: transparent; border: none; }
.chat-input-area button { width: auto; padding: 12px 24px; border-radius: 14px; }

/* Media Center Grid */
.media-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.media-card { background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 16px; padding: 16px; cursor: pointer; transition: 0.3s; }
.media-card:active { transform: scale(0.95); background: rgba(255,255,255,0.1); }
.media-card h3 { font-size: 0.9em; font-weight: 700; word-break: break-word; margin-bottom: 6px; }
.media-card p { font-size: 0.75em; color: var(--muted); font-family: var(--font-mono); }

/* Lightbox Premium */
#lightbox {
  display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.95);
  backdrop-filter: blur(20px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;
  animation: fadeIn 0.3s;
}
#lightbox video, #lightbox img { max-width: 100%; max-height: 90vh; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.8); }
#lightbox audio { width: 90vw; }
</style>
</head>
<body>
<header>
  <div class="menu-btn" onclick="toggleMenu()">☰</div>
  <div class="logo-small"><img src="/assets/logo.png" onerror="this.style.display='none'"> KEIZ OS</div>
  <div style="width:24px;"></div>
</header>
<div class="overlay" onclick="toggleMenu()"></div>
<aside class="sidebar" id="sidebar">
  <div class="nav-item active" onclick="nav('inicio', this)">🏠 <span>Inicio</span></div>
  <div class="nav-item" onclick="nav('chat', this)">🤖 <span>Dios</span></div>
  <div class="nav-item" onclick="nav('media', this)">🎞️ <span>Media Center</span></div>
  <div class="nav-item" onclick="nav('musica', this)">🎵 <span>Música</span></div>
  <div class="nav-item" onclick="nav('imagen', this)">🎨 <span>Imagen</span></div>
  <div class="nav-item" onclick="nav('voz', this)">🎙️ <span>Voz</span></div>
  <div class="nav-item" onclick="nav('video', this)">🎬 <span>Vídeo</span></div>
  <div class="nav-item" onclick="nav('ajustes', this)">⚙️ <span>Ajustes</span></div>
</aside>

<main class="main">
  <!-- INICIO -->
  <div id="view-inicio" class="view active">
    <div class="section">
      <h2 style="font-size:2.2em; line-height:1.1; margin-bottom:8px;">Buenas noches,<br>Arquitecto.</h2>
      <p class="desc">El imperio está en línea. ¿Qué vamos a crear hoy?</p>
      <div id="dash-status" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">Cargando datos...</div>
    </div>
  </div>

  <!-- CHAT -->
  <div id="view-chat" class="view">
    <div class="chat-container">
      <div id="chat-messages" class="chat-messages">
        <div class="msg bot">> Sistema listo. Memoria conectada. ¿Qué necesitas, Arquitecto?</div>
      </div>
      <div class="chat-input-area">
        <input id="chat-input" placeholder="Escribe o usa el micro..." onkeydown="if(event.key==='Enter')enviarChat()" />
<button class="dash-btn" id="btn-jarvis" onclick="toggleJarvis()" style="background:rgba(255,255,255,0.1); width:auto; padding:12px 16px; border-radius:50%;" title="Modo Jarvis">🎙️</button>
        <button class="dash-btn" onclick="enviarChat()">➤</button>
      </div>
    </div>
  </div>

  <!-- MEDIA CENTER -->
  <div id="view-video" class="view">
    <div class="section">
      <h2>🎬 Video Studio</h2>
      <p class="desc">Genera clips cinematográficos con Wan 2.2 en Kaggle. Usa la fórmula: Sujeto → Movimiento → Cámara → Iluminación.</p>
      <textarea id="video-prompt" placeholder="Ej: Un zorro rojo se mueve sigilosamente por la nieve, cámara de seguimiento, hora dorada" style="height:80px; margin-bottom:12px;"></textarea>
      <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
        <select id="video-formato" style="flex:1; min-width:120px; padding:10px; background:rgba(0,0,0,0.3); border:1px solid var(--border); border-radius:12px; color:#fff;">
          <option value="horizontal">Horizontal (16:9 · 1280x704)</option>
          <option value="vertical">Vertical (9:16 · 704x1280)</option>
        </select>
        <select id="video-duracion" style="flex:1; min-width:120px; padding:10px; background:rgba(0,0,0,0.3); border:1px solid var(--border); border-radius:12px; color:#fff;">
          <option value="5">5 segundos (~3.4s real)</option>
          <option value="8">8 segundos</option>
          <option value="10">10 segundos</option>
        </select>
        <button class="dash-btn" style="width:auto; padding:12px 24px;" onclick="generarVideoWeb()">Generar</button>
      </div>
      <div id="video-log" style="margin-bottom:12px; font-family:var(--font-mono); font-size:0.8em; color:var(--muted);"></div>
      <h3 style="font-size:1em; margin-bottom:12px;">Vídeos recientes</h3>
      <div id="lista-video" class="media-grid"><p style="color:var(--muted);">Cargando...</p></div>
    </div>
  </div>

  <div id="view-media" class="view">
    <div class="section">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; gap:12px;">
        <h2 style="margin-bottom:0;">Media Vault</h2>
        <div style="display:flex; gap:8px; align-items:center;">
          <select id="vault-filtro" onchange="filtrarVault()" style="padding:8px; background:rgba(255,255,255,0.1); color:#fff; border:1px solid var(--border); border-radius:8px; font-size:0.9em;">
            <option value="todos">Todos</option>
            <option value="musica">🎵 Música</option>
            <option value="tts">🎙️ TTS</option>
            <option value="video">🎬 Vídeo</option>
            <option value="imagen">🖼️ Imagen</option>
            <option value="audio">🔊 Audio</option>
          </select>
          <button onclick="cargarVault()" style="background:none; border:none; color:#fff; font-size:1.5em; cursor:pointer;">🔄</button>
        </div>
      </div>
      <div id="lista-vault" class="media-grid"><p style="color:var(--muted);">Cargando archivos...</p></div>
    </div>
  </div>

  <!-- MUSICA -->
  <div id="view-musica" class="view">
    <div class="section">
      <h2>🎵 Música Studio</h2>
      <p class="desc">Genera pistas con ACE-Step en Kaggle.</p>
      <input id="music-prompt" placeholder="Ej: lofi piano chill, 60 bpm" />
      <div style="display:flex; gap:8px; margin-bottom:16px;">
        <select id="music-dur" style="flex:1; padding:10px; background:rgba(0,0,0,0.3); border:1px solid var(--border); border-radius:12px; color:#fff;">
          <option value="30">30 segundos</option>
          <option value="60" selected>60 segundos</option>
          <option value="180">3 minutos</option>
        </select>
        <button class="dash-btn" style="width:auto; padding:12px 24px;" onclick="generarMusicaWeb()">Generar</button>
      </div>
      <div id="music-log" style="margin-bottom:12px; font-family:var(--font-mono); font-size:0.8em; color:var(--muted);"></div>
      <h3 style="font-size:1em; margin-bottom:12px;">Generadas recientemente</h3>
      <div id="lista-musica" class="media-grid"><p style="color:var(--muted);">Cargando...</p></div>
    </div>
  </div>
  </div>

  <!-- IMAGEN -->
  <div id="view-imagen" class="view">
    <div class="section">
      <h2>🎨 Image Studio</h2>
      <p class="desc">Genera imágenes con Cloudflare SDXL.</p>
      <input id="img-prompt" placeholder="Ej: cinematic rocket launch" />
      <button class="dash-btn" onclick="generarImagenWeb()">Generar Imagen</button>
      <div id="img-log" style="margin-top:12px; margin-bottom:16px; font-family:var(--font-mono); font-size:0.8em; color:var(--muted);"></div>
      <h3 style="font-size:1em; margin-bottom:12px;">Imágenes recientes</h3>
      <div id="lista-imagen" class="media-grid"><p style="color:var(--muted);">Cargando...</p></div>
    </div>
  </div>
  </div>

  <!-- VOZ -->
  <div id="view-voz" class="view">
    <div class="section">
      <h2>🎙️ Voice Studio</h2>
      <p class="desc">Narra textos con la voz del Dios (Sherpa-ONNX).</p>
      <textarea id="voz-texto" placeholder="Escribe el texto a narrar..."></textarea>
      <div style="display:flex; gap:8px; margin-bottom:16px;">
        <select id="voz-opcion" style="flex:1; padding:10px; background:rgba(0,0,0,0.3); border:1px solid var(--border); border-radius:12px; color:#fff;">
          <option value="es_ES-davefx-medium">Davefx (Español, oficial)</option>
          <option value="es_ES-sharvard-medium">Sharvard (Español)</option>
          <option value="es_MX-claude-high">Claude (México)</option>
          <option value="en_US-lessac-medium">Lessac (Inglés)</option>
          <option value="en_US-ryan-high">Ryan (Inglés)</option>
        </select>
        <button class="dash-btn" style="width:auto; padding:12px 24px;" onclick="generarVozWeb()">Generar</button>
      </div>
      <div id="voz-log" style="margin-bottom:12px; font-family:var(--font-mono); font-size:0.8em; color:var(--muted);"></div>
      <h3 style="font-size:1em; margin-bottom:12px;">Audios recientes</h3>
      <div id="lista-voz" class="media-grid"><p style="color:var(--muted);">Cargando...</p></div>
    </div>
  </div>
  </div>

<div id="view-ajustes" class="view">
  <div class="section">
    <h2>⚙️ Personalización</h2>
    <p class="desc">Ajusta el ecosistema a tu gusto.</p>
    
    <label style="display:block; color:var(--muted); margin-bottom:8px;">Tema de color:</label>
    <select id="set-tema" onchange="cambiarTema(this.value)" style="width:100%; margin-bottom:20px;">
      <option value="os">Oscuro (Apple OS)</option>
      <option value="cyber">Cyberpunk (Neón)</option>
      <option value="matrix">Matrix (Verde)</option>
      <option value="light">Claro (Lujo)</option>
    </select>

    <label style="display:block; color:var(--muted); margin-bottom:8px;">Voz del Dios:</label>
    <select id="set-voz" style="width:100%; margin-bottom:20px;">
      <option value="es_ES-davefx-medium">Davefx (Español, oficial)</option>
      <option value="es_ES-sharvard-medium">Sharvard (Español)</option>
      <option value="es_MX-claude-high">Claude (México)</option>
      <option value="en_US-lessac-medium">Lessac (Inglés)</option>
      <option value="en_US-ryan-high">Ryan (Inglés)</option>
    </select>

    <label style="display:block; color:var(--muted); margin-bottom:8px;">Tamaño de letra: <span id="val-letra">1.0em</span></label>
    <input type="range" id="set-letra" min="0.8" max="1.4" step="0.1" value="1.0" oninput="cambiarLetra(this.value)" style="margin-bottom:20px;">

    <label style="display:block; color:var(--muted); margin-bottom:8px;">Radio de bordes: <span id="val-radio">20px</span></label>
    <input type="range" id="set-radio" min="0" max="40" step="4" value="20" oninput="cambiarRadio(this.value)" style="margin-bottom:20px;">

    <button class="dash-btn" onclick="guardarAjustes()">Guardar Preferencias</button>
  </div>

  <div class="section">
    <h2>🔌 APIs y Servicios</h2>
    <p class="desc">Configura las llaves de acceso. Haz clic en cada servicio para ver cómo obtenerla.</p>
    
    <div class="api-item" onclick="toggleApi('youtube')">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--border);">
        <span>📺 YouTube (OAuth)</span>
        <span style="color:#10b981;">🟢</span>
      </div>
    </div>
    <div id="api-info-youtube" style="display:none; padding:12px; background:rgba(0,0,0,0.3); border-radius:8px; margin-bottom:12px; font-size:0.85em; color:var(--muted);">
      <p>Ya tienes el OAuth configurado.</p>
    </div>

    <div class="api-item" onclick="toggleApi('groq')">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--border);">
        <span>🧠 Groq (LLM)</span>
        <span style="color:#10b981;">🟢</span>
      </div>
    </div>
    <div id="api-info-groq" style="display:none; padding:12px; background:rgba(0,0,0,0.3); border-radius:8px; margin-bottom:12px; font-size:0.85em; color:var(--muted);">
      <p>1. Ve a <a href="https://console.groq.com/keys" target="_blank" style="color:var(--accent);">console.groq.com/keys</a></p>
      <p>2. Crea una API Key.</p>
      <p>3. Pégala aquí abajo.</p>
      <input id="input-groq" placeholder="gsk_..." style="margin-top:8px; width:100%; padding:8px; border-radius:6px; border:1px solid var(--border); background:rgba(0,0,0,0.5); color:#fff;" />
      <button class="dash-btn" style="padding:8px; font-size:0.8em; margin-top:8px; width:auto;" onclick="guardarApi('groq')">Guardar</button>
    </div>

    <div class="api-item" onclick="toggleApi('kaggle')">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--border);">
        <span>☁️ Kaggle (GPU)</span>
        <span style="color:#10b981;">🟢</span>
      </div>
    </div>
    <div id="api-info-kaggle" style="display:none; padding:12px; background:rgba(0,0,0,0.3); border-radius:8px; margin-bottom:12px; font-size:0.85em; color:var(--muted);">
      <p>1. Ve a <a href="https://www.kaggle.com/settings" target="_blank" style="color:var(--accent);">kaggle.com/settings</a></p>
      <p>2. En "API", pulsa "Create New Token".</p>
      <p>3. Copia el token (KGAT_...).</p>
      <input id="input-kaggle" placeholder="KGAT_..." style="margin-top:8px; width:100%; padding:8px; border-radius:6px; border:1px solid var(--border); background:rgba(0,0,0,0.5); color:#fff;" />
      <button class="dash-btn" style="padding:8px; font-size:0.8em; margin-top:8px; width:auto;" onclick="guardarApi('kaggle')">Guardar</button>
    </div>

    <div class="api-item" onclick="toggleApi('cloudflare')">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--border);">
        <span>🎨 Cloudflare (Imágenes)</span>
        <span style="color:#10b981;">🟢</span>
      </div>
    </div>
    <div id="api-info-cloudflare" style="display:none; padding:12px; background:rgba(0,0,0,0.3); border-radius:8px; margin-bottom:12px; font-size:0.85em; color:var(--muted);">
      <p>1. Ve a <a href="https://dash.cloudflare.com/profile/api-tokens" target="_blank" style="color:var(--accent);">Cloudflare API Tokens</a></p>
      <p>2. Crea un token con permiso de "Workers AI".</p>
      <input id="input-cloudflare" placeholder="Token..." style="margin-top:8px; width:100%; padding:8px; border-radius:6px; border:1px solid var(--border); background:rgba(0,0,0,0.5); color:#fff;" />
      <button class="dash-btn" style="padding:8px; font-size:0.8em; margin-top:8px; width:auto;" onclick="guardarApi('cloudflare')">Guardar</button>
    </div>

    <div class="api-item" onclick="toggleApi('pixabay')">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--border);">
        <span>🎬 Pixabay (Vídeos stock)</span>
        <span style="color:#10b981;">🟢</span>
      </div>
    </div>
    <div id="api-info-pixabay" style="display:none; padding:12px; background:rgba(0,0,0,0.3); border-radius:8px; margin-bottom:12px; font-size:0.85em; color:var(--muted);">
      <p>1. Ve a <a href="https://pixabay.com/api/docs/" target="_blank" style="color:var(--accent);">pixabay.com/api/docs/</a></p>
      <p>2. Copia tu clave.</p>
      <input id="input-pixabay" placeholder="Clave..." style="margin-top:8px; width:100%; padding:8px; border-radius:6px; border:1px solid var(--border); background:rgba(0,0,0,0.5); color:#fff;" />
      <button class="dash-btn" style="padding:8px; font-size:0.8em; margin-top:8px; width:auto;" onclick="guardarApi('pixabay')">Guardar</button>
    </div>
  </div>

  <div class="section">
    <h2>🚨 Superpoder de Dios: Auditoría</h2>
    <p class="desc">Dios auditará la web, los logs y el código. Pedirá tu consentimiento antes de reparar.</p>
    <button class="dash-btn" style="background:#ff3b30;" onclick="auditarDios()">🩺 Auditar el Ecosistema</button>
    <div id="audit-log" style="margin-top:16px; font-family:var(--font-mono); font-size:0.8em; color:var(--muted);"></div>
  </div>
</div>

</main>

<div id="lightbox" onclick="cerrarLightbox(event)"><div id="lightbox-content"></div></div>

<script>
function toggleMenu(){ document.getElementById('sidebar').classList.toggle('open'); document.querySelector('.overlay').classList.toggle('open'); }
function nav(id, el){ 
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active')); 
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active')); 
  document.getElementById('view-'+id).classList.add('active'); 
  if(el)el.classList.add('active'); 
  if(window.innerWidth<768) toggleMenu(); 
  if(id==='media')cargarVault(); 
  if(id==='inicio')cargarDashboard(); 
  if(id==='chat')setTimeout(()=>document.getElementById('chat-input')?.focus(), 100); 
}

async function cargarDashboard(){ 
    try{ 
        const r=await fetch('/api/dashboard'); const d=await r.json(); 
        document.getElementById('dash-status').innerHTML=`
            <div style="background:rgba(255,255,255,0.05); padding:16px; border-radius:16px; border:1px solid var(--border);">Flask: ${d.salud.flask==='ok'?'🟢':'🔴'}</div>
            <div style="background:rgba(255,255,255,0.05); padding:16px; border-radius:16px; border:1px solid var(--border);">OmniRoute: ${d.salud.omniroute==='ok'?'🟢':'🔴'}</div>
            <div style="background:rgba(255,255,255,0.05); padding:16px; border-radius:16px; border:1px solid var(--border);">Worker: ${d.salud.worker==='ok'?'🟢':'🔴'}</div>
            <div style="background:rgba(255,255,255,0.05); padding:16px; border-radius:16px; border:1px solid var(--border);">Repo: ${d.salud.repo}</div>
        `;
    }catch(e){ console.error(e); } 
}

async function enviarChat(isJarvis = false) {
    const input = document.getElementById('chat-input');
    const text = input.value.trim();
    if(!text) return;
    input.value = '';
    const msgs = document.getElementById('chat-messages');
    msgs.innerHTML += `<div class="msg user">${text}</div>`;
    msgs.scrollTop = msgs.scrollHeight;
    
    const loadingId = 'load-' + Date.now();
    msgs.innerHTML += `<div id="${loadingId}" class="msg bot" style="color:var(--muted);">Pensando...</div>`;
    msgs.scrollTop = msgs.scrollHeight;

    try {
        const res = await fetch('/api/chat', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({mensaje: text})});
        const data = await res.json();
        
        // Fast-Path (respuesta directa)
        if(data.status === 'reply') {
            const el = document.getElementById(loadingId);
            if(el) el.innerText = data.reply;
            if(isJarvis && typeof hablarTexto === 'function') hablarTexto(data.reply);
            return;
        }
        
        // LLM (streaming SSE)
        if(data.status === 'processing') {
            const evt = new EventSource('/api/chat_stream/' + data.task_id);
            let respuestaCompleta = "";
            let audioQueue = [];
            let isPlayingAudio = false;
            
            evt.onmessage = function(e) {
                if(e.data.includes('[+]') || e.data.includes('[dios]')) return;
                
                let linea = e.data;
                try { linea = JSON.parse(e.data); } catch(err) {}
                respuestaCompleta += linea + "\n";
                
                const el = document.getElementById(loadingId);
                if(el) {
                    el.innerHTML = respuestaCompleta.replace(/\n/g, '<br>');
                    msgs.scrollTop = msgs.scrollHeight;
                }
            };
            
            // Al finalizar
            const finalizar = async function() {
                evt.close();
                const el = document.getElementById(loadingId);
                if(!el) return;
                
                // Añadir reproductor
                const audioId = 'audio-' + Date.now();
                el.innerHTML += `
                    <div id="${audioId}" style="display:flex; gap:8px; margin-top:12px; align-items:center;">
                        <button onclick="controlarAudio('${audioId}', 'play')" style="background:var(--accent); border:none; color:#fff; border-radius:50%; width:36px; height:36px; cursor:pointer;">▶</button>
                        <button onclick="controlarAudio('${audioId}', 'pause')" style="background:var(--surface); border:1px solid var(--border); color:#fff; border-radius:50%; width:36px; height:36px; cursor:pointer;">⏸</button>
                        <button onclick="controlarAudio('${audioId}', 'stop')" style="background:var(--surface); border:1px solid var(--border); color:#fff; border-radius:50%; width:36px; height:36px; cursor:pointer;">⏹</button>
                        <span id="${audioId}-status" style="font-size:0.75em; color:var(--muted);">Generando voz...</span>
                    </div>
                `;
                
                // Generar audio
                try {
                    const r = await fetch('/api/dios_hablar', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({texto: respuestaCompleta.substring(0, 500)})});
                    const d = await r.json();
                    if(d.status === 'ok' && d.url) {
                        const status = document.getElementById(audioId + '-status');
                        status.innerText = 'Voz lista';
                        window['audio_' + audioId] = new Audio(d.url);
                        
                        if(isJarvis) {
                            window['audio_' + audioId].play();
                            status.innerText = '🔊 Reproduciendo...';
                            window['audio_' + audioId].onended = () => {
                                status.innerText = 'Voz lista';
                                if(jarvisActivo && recognition) try { recognition.start(); } catch(e){}
                            };
                        }
                    } else {
                        document.getElementById(audioId + '-status').innerText = '❌ Error al generar voz';
                    }
                } catch(e) {
                    document.getElementById(audioId + '-status').innerText = '❌ Error de red';
                }
            };
            
            evt.onerror = function() { evt.close(); finalizar(); };
            const originalOnMessage = evt.onmessage;
            evt.onmessage = function(e) {
                originalOnMessage(e);
                if(e.data.includes('[+] Proceso finalizado')) finalizar();
            };
        }
    } catch(e) { 
        const el = document.getElementById(loadingId);
        if(el) el.innerText = '❌ Error de conexión'; 
    }
}

function controlarAudio(audioId, accion) {
    const audio = window['audio_' + audioId];
    const status = document.getElementById(audioId + '-status');
    if(!audio) return;
    if(accion === 'play') { audio.play(); if(status) status.innerText = '🔊 Reproduciendo...'; }
    else if(accion === 'pause') { audio.pause(); if(status) status.innerText = '⏸ Pausado'; }
    else if(accion === 'stop') { audio.pause(); audio.currentTime = 0; if(status) status.innerText = '⏹ Detenido'; }
}

let _vaultItems = [];

async function cargarVault(){
    const g = document.getElementById('lista-vault');
    if(!g) return;
    g.innerHTML = '<p style="color:var(--muted);">Cargando...</p>';
    try{
        const r = await fetch('/api/media_vault');
        _vaultItems = await r.json();
        filtrarVault();
    }catch(e){
        g.innerHTML = '<p style="color:var(--muted);">Error de conexion</p>';
    }
}

function filtrarVault(){
    const g = document.getElementById('lista-vault');
    if(!g) return;
    const sel = document.getElementById('vault-filtro');
    const filtro = sel ? sel.value : 'todos';
    const items = filtro === 'todos' ? _vaultItems : _vaultItems.filter(i => (i.categoria || i.tipo) === filtro);
    if(items.length === 0){
        g.innerHTML = '<p style="color:var(--muted);">No hay archivos de este tipo.</p>';
        return;
    }
    const iconos = {musica:'🎵', tts:'🎙️', video:'🎬', imagen:'🖼️', audio:'🔊'};
    g.innerHTML = items.map(i =>
        '<div class="media-card" onclick="abrirLightbox(\'' + i.url + '\',\'' + i.tipo + '\')">' +
        '<div style="font-size:2em; margin-bottom:8px;">' + (iconos[i.categoria] || '📄') + '</div>' +
        '<h3>' + i.nombre + '</h3>' +
        '<p>' + i.fecha + ' · ' + (i.tamano/1024/1024).toFixed(1) + 'MB</p>' +
        '</div>'
    ).join('');
}


function abrirLightbox(url,tipo){ 
    const lb=document.getElementById('lightbox'); const c=document.getElementById('lightbox-content'); 
    if(tipo==='video')c.innerHTML=`<video src="${url}" controls autoplay></video>`; 
    else if(tipo==='audio')c.innerHTML=`<audio src="${url}" controls autoplay></audio>`; 
    else c.innerHTML=`<img src="${url}">`; 
    lb.style.display='flex'; 
}

function cerrarLightbox(e){ if(e.target.id==='lightbox'){ document.getElementById('lightbox').style.display='none'; document.getElementById('lightbox-content').innerHTML=''; } }

async function generarMusicaWeb() {
    const prompt = document.getElementById('music-prompt').value.trim();
    if(!prompt) return alert('Escribe un prompt');
    const log = document.getElementById('music-log');
    log.innerText = '⏳ Lanzando petición a Kaggle (esto tarda ~30 min)...';
    try {
        const r = await fetch('/api/generar_musica_acestep', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({prompt: prompt, duracion: 30})});
        const d = await r.json();
        log.innerText = d.reply || d.mensaje || 'Petición enviada.';
    } catch(e) { log.innerText = '❌ Error: ' + e.message; }
}

async function generarImagenWeb() {
    const prompt = document.getElementById('img-prompt').value.trim();
    if(!prompt) return alert('Escribe un prompt');
    const log = document.getElementById('img-log');
    log.innerText = '⏳ Generando imagen...';
    try {
        const r = await fetch('/api/generar_imagen', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({prompt: prompt})});
        const d = await r.json();
