        const d = await r.json();
        log.innerText = d.status === 'ok' ? '✅ ' + d.mensaje : '❌ ' + (d.mensaje || 'Error');
    } catch(e) { log.innerText = '❌ Error: ' + e.message; }
}


// ═══ MODO JARVIS (Voz + Oído) ═══
let jarvisActivo = false;
let recognition = null;
let isSpeaking = false;

function initJarvis() {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
        alert("Tu navegador no soporta reconocimiento de voz. Usa Chrome.");
        return null;
    }
    const rec = new SpeechRecognition();
    rec.lang = 'es-ES';
    rec.continuous = false; // Se para al dejar de hablar
    rec.interimResults = false;

    rec.onstart = () => {
        document.getElementById('btn-jarvis').style.background = '#ff3b30'; // Rojo cuando escucha
        document.getElementById('btn-jarvis').style.boxShadow = '0 0 15px #ff3b30';
        const msgs = document.getElementById('chat-messages');
        msgs.innerHTML += `<div class="msg user" style="opacity:0.5; font-style:italic;">Escuchando...</div>`;
        msgs.scrollTop = msgs.scrollHeight;
    };

    rec.onresult = (event) => {
        const text = event.results[0][0].transcript;
        document.getElementById('chat-input').value = text;
        enviarChat(true); // true = Modo Jarvis (responde con voz)
    };

    rec.onerror = (event) => {
        detenerJarvis();
    };

    rec.onend = () => {
        if (!isSpeaking && jarvisActivo) {
            // Si no está hablando el bot y jarvis sigue activo, vuelve a escuchar
            setTimeout(() => { try { rec.start(); } catch(e){} }, 500);
        } else {
            document.getElementById('btn-jarvis').style.background = 'rgba(255,255,255,0.1)';
            document.getElementById('btn-jarvis').style.boxShadow = 'none';
        }
    };

    return rec;
}

function toggleJarvis() {
    if (!recognition) recognition = initJarvis();
    if (!recognition) return;

    jarvisActivo = !jarvisActivo;
    if (jarvisActivo) {
        try { recognition.start(); } catch(e){}
    } else {
        try { recognition.stop(); } catch(e){}
        document.getElementById('btn-jarvis').style.background = 'rgba(255,255,255,0.1)';
    }
}

function detenerJarvis() {
    jarvisActivo = false;
    if (recognition) try { recognition.stop(); } catch(e){}
    document.getElementById('btn-jarvis').style.background = 'rgba(255,255,255,0.1)';
    document.getElementById('btn-jarvis').style.boxShadow = 'none';
}

async function hablarTexto(texto) {
    if (!texto) return;
    isSpeaking = true;
    try {
        const res = await fetch('/api/dios_hablar', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ texto: texto.substring(0, 500) })
        });
        const data = await res.json();
        
        if (data.status === 'ok' && data.url) {
            const audio = new Audio(data.url);
            audio.onended = () => {
                isSpeaking = false;
                if (jarvisActivo && recognition) try { recognition.start(); } catch(e){}
            };
            audio.play();
        } else {
            // Fallback: voz del navegador
            const utterance = new SpeechSynthesisUtterance(texto);
            utterance.lang = 'es-ES';
            utterance.onend = () => {
                isSpeaking = false;
                if (jarvisActivo && recognition) try { recognition.start(); } catch(e){}
            };
            window.speechSynthesis.speak(utterance);
        }
    } catch(e) {
        isSpeaking = false;
        // Al terminar de hablar, si Jarvis está activo, volver a escuchar
        if (jarvisActivo && recognition) {
            setTimeout(() => {
                try { recognition.start(); } catch(err){}
            }, 500);
        }
    }
}

document.addEventListener('DOMContentLoaded', cargarDashboard);



function cambiarTema(tema) {
    const root = document.documentElement;
    if (tema === 'cyber') {
        root.style.setProperty('--bg', '#0a001a');
        root.style.setProperty('--accent', '#ff00ff');
        root.style.setProperty('--surface', 'rgba(30, 0, 40, 0.7)');
    } else if (tema === 'matrix') {
        root.style.setProperty('--bg', '#000a00');
        root.style.setProperty('--accent', '#00ff41');
        root.style.setProperty('--surface', 'rgba(0, 20, 0, 0.7)');
    } else if (tema === 'light') {
        root.style.setProperty('--bg', '#f5f5f7');
        root.style.setProperty('--accent', '#007aff');
        root.style.setProperty('--surface', 'rgba(255, 255, 255, 0.7)');
        root.style.setProperty('--text', '#1d1d1f');
    } else {
        root.style.setProperty('--bg', '#000000');
        root.style.setProperty('--accent', '#007aff');
        root.style.setProperty('--surface', 'rgba(20, 20, 25, 0.6)');
        root.style.setProperty('--text', '#ffffff');
    }
    localStorage.setItem('tema', tema);
}

function cambiarLetra(val) {
    const el = document.getElementById('val-letra');
    if (el) el.innerText = val + 'em';
    document.body.style.fontSize = val + 'em';
    localStorage.setItem('letra', val);
}

function cambiarRadio(val) {
    const el = document.getElementById('val-radio');
    if (el) el.innerText = val + 'px';
    document.documentElement.style.setProperty('--radius', val + 'px');
    localStorage.setItem('radio', val);
}

function guardarAjustes() {
    const voz = document.getElementById('set-voz');
    if (voz) localStorage.setItem('voz', voz.value);
    alert('✅ Ajustes guardados.');
}

function cargarAjustes() {
    const tema = localStorage.getItem('tema');
    if (tema) { const el = document.getElementById('set-tema'); if (el) el.value = tema; cambiarTema(tema); }
    const letra = localStorage.getItem('letra');
    if (letra) { const el = document.getElementById('set-letra'); if (el) el.value = letra; cambiarLetra(letra); }
    const radio = localStorage.getItem('radio');
    if (radio) { const el = document.getElementById('set-radio'); if (el) el.value = radio; cambiarRadio(radio); }
    const voz = localStorage.getItem('voz');
    if (voz) { const el = document.getElementById('set-voz'); if (el) el.value = voz; }
}


// ═══ STUDIOS: CARGA DE LISTAS ═══
async function cargarStudioFiles(tipo) {
    const cont = document.getElementById('lista-' + tipo);
    if(!cont) return;
    try {
        const r = await fetch('/api/studio_files?tipo=' + tipo);
        const items = await r.json();
        if(items.length === 0) {
            cont.innerHTML = '<p style="color:var(--muted);">No hay archivos generados aún.</p>';
            return;
        }
        cont.innerHTML = items.map(i => {
            const dur = i.duracion ? ' · ' + i.duracion + 's' : '';
            const isImg = i.nombre.match(/\.(png|jpg|jpeg)$/i);
            const thumb = isImg ? `<img src="${i.url}" style="width:100%; height:100px; object-fit:cover; border-radius:8px; margin-bottom:8px;" />` : '<div style="font-size:2em; margin-bottom:8px;">' + (tipo === 'musica' ? '🎵' : tipo === 'tts' ? '🎙️' : '🖼️') + '</div>';
            return `<div class="media-card" onclick="abrirLightbox('${i.url}','${isImg ? 'image' : 'audio'}')">${thumb}<h3>${i.nombre}</h3><p>${i.fecha}${dur} · ${(i.tamano/1024/1024).toFixed(1)}MB</p></div>`;
        }).join('');
    } catch(e) { cont.innerHTML = '<p style="color:var(--muted);">Error al cargar.</p>'; }
}

// Recargar lista después de generar
async function _postGeneracion(tipo, logEl, mensaje) {
    if(logEl) logEl.innerText = mensaje;
    cargarStudioFiles(tipo);
    cargarVault(); // También actualizar el media center
}

// ═══ ACTUALIZAR LAS FUNCIONES DE GENERACIÓN ═══
async function generarMusicaWeb() {
    const prompt = document.getElementById('music-prompt').value.trim();
    const dur = parseInt(document.getElementById('music-dur').value);
    const log = document.getElementById('music-log');
    if(!prompt) return alert('Escribe un prompt');
    log.innerText = '⏳ Lanzando petición a Kaggle (~30 min)...';
    try {
        const r = await fetch('/api/generar_musica_acestep', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({prompt: prompt, duracion: dur})});
        const d = await r.json();
        _postGeneracion('musica', log, d.reply || d.mensaje || '✅ Petición enviada.');
    } catch(e) { log.innerText = '❌ Error: ' + e.message; }
}

async function generarImagenWeb() {
    const prompt = document.getElementById('img-prompt').value.trim();
    const log = document.getElementById('img-log');
    if(!prompt) return alert('Escribe un prompt');
    log.innerText = '⏳ Generando imagen...';
    try {
        const r = await fetch('/api/generar_imagen', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({prompt: prompt})});
        const d = await r.json();
        _postGeneracion('imagen', log, d.status === 'ok' ? '✅ ' + d.mensaje : '❌ ' + (d.mensaje || 'Error'));
    } catch(e) { log.innerText = '❌ Error: ' + e.message; }
}

async function generarVozWeb() {
    const texto = document.getElementById('voz-texto').value.trim();
    const voz = document.getElementById('voz-opcion').value;
    const log = document.getElementById('voz-log');
    if(!texto) return alert('Escribe un texto');
    log.innerText = '⏳ Generando voz...';
    try {
        const r = await fetch('/api/voice_studio', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({texto: texto, voz: voz})});
        const d = await r.json();
        _postGeneracion('tts', log, d.status === 'ok' ? '✅ ' + d.mensaje : '❌ ' + (d.mensaje || 'Error'));
    } catch(e) { log.innerText = '❌ Error: ' + e.message; }
}

// Cargar las listas cuando se entra a cada vista
const _navOrig2 = _nav_orig;
_nav_orig = function(v, el) {
    _navOrig2(v, el);
    if(v === 'musica') setTimeout(() => cargarStudioFiles('musica'), 300);
    if(v === 'imagen') setTimeout(() => cargarStudioFiles('imagen'), 300);
    if(v === 'voz') setTimeout(() => cargarStudioFiles('tts'), 300);
    if(v === 'video') setTimeout(() => cargarStudioFiles('video'), 300);
};


// ═══ FUNCIONES DE PESTAÑAS ═══
async function cargarCanales() {
    try {
        const r = await fetch('/api/canales_web');
