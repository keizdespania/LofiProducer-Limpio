        const nichos = document.getElementById('canales-nichos');
        if(nichos) nichos.innerHTML = (d.nichos_base || []).map(n => `<div class="media-card"><h3>${n}</h3><p>Nicho base</p></div>`).join('');
        const creados = document.getElementById('canales-creados');
        if(creados) creados.innerHTML = (d.canales_creados || []).length === 0 ? '<p style="color:var(--muted);">Sin canales creados aún.</p>' : (d.canales_creados || []).map(c => `<div class="media-card"><h3>${c.nombre || c.id}</h3><p>Nicho: ${c.nicho_base}</p></div>`).join('');
    } catch(e) {}
}

async function cargarCola() {
    try {
        const r = await fetch('/api/cola_tareas');
        const tareas = await r.json();
        const cont = document.getElementById('cola-tareas');
        if(!cont) return;
        if(tareas.length === 0) { cont.innerHTML = '<p style="color:var(--muted);">Sin tareas en cola.</p>'; return; }
        cont.innerHTML = tareas.map(t => `<div class="media-card" style="margin-bottom:8px;"><h3>${t.session_id}: ${t.prompt}</h3><p>${t.estado} · ${t.creada.substring(0,16)}</p></div>`).join('');
    } catch(e) {}
}

async function llamarDoctor() {
    const log = document.getElementById('doctor-log');
    if(!log) return;
    log.innerText = '⏳ Diagnosticando...';
    try {
        const r = await fetch('/api/doctor', {method:'POST'});
        const d = await r.json();
        log.innerText = d.reporte || d.mensaje || 'OK';
    } catch(e) { log.innerText = '❌ ' + e.message; }
}

async function leerRSS() {
    const fuente = document.getElementById('rss-fuente').value;
    const log = document.getElementById('rss-log');
    if(!log) return;
    log.innerText = '⏳ Leyendo ' + fuente + '...';
    try {
        const r = await fetch('/api/rss_leer', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({fuente})});
        const d = await r.json();
        log.innerText = d.noticias || d.mensaje || 'Sin noticias';
    } catch(e) { log.innerText = '❌ ' + e.message; }
}

async function cargarEspecialistas() {
    try {
        const r = await fetch('/api/especialistas');
        const roles = await r.json();
        const cont = document.getElementById('lista-especialistas');
        if(!cont) return;
        cont.innerHTML = roles.map(role => `<div class="media-card"><h3>🧠 ${role.rol}</h3><p>${role.desc}</p></div>`).join('');
    } catch(e) {}
}

// Hook del nav
const _navOrig3 = _nav_orig;
_nav_orig = function(v, el) {
    _navOrig3(v, el);
    if(v === 'canales') setTimeout(cargarCanales, 300);
    if(v === 'produccion') setTimeout(cargarCola, 300);
    if(v === 'especialista') setTimeout(cargarEspecialistas, 300);
};


async function cargarAnalytics() {
    try {
        const r = await fetch('/api/dashboard');
        const d = await r.json();
        const cont = document.getElementById('analytics-content');
        if(!cont) return;
        const s = d.salud || {};
        cont.innerHTML = `
            <div class="media-grid">
                <div class="media-card"><h3>Flask</h3><p>${s.flask === 'ok' ? '🟢 OK' : '🔴 DOWN'}</p></div>
                <div class="media-card"><h3>OmniRoute</h3><p>${s.omniroute === 'ok' ? '🟢 OK' : '🔴 DOWN'}</p></div>
                <div class="media-card"><h3>Worker</h3><p>${s.worker === 'ok' ? '🟢 OK' : '🔴 DOWN'}</p></div>
                <div class="media-card"><h3>Repo</h3><p>${s.repo || '?'}</p></div>
                <div class="media-card"><h3>Tareas recientes</h3><p>${(d.tareas || []).length}</p></div>
                <div class="media-card"><h3>Uptime</h3><p>24h</p></div>
            </div>
        `;
    } catch(e) {}
}

async function cargarDocs() {
    try {
        const r = await fetch('/api/docs');
        const docs = ['ESTADO.md', 'MANUAL_FRODO_PYTHON.md', 'docs/INDICE.md', 'docs/MANUALES/KAGGLE.md', 'docs/MANUALES/WAN.md'];
        const cont = document.getElementById('docs-content');
        if(!cont) return;
        cont.innerHTML = docs.map(d => `<div class="media-card" onclick="alert('Abre: ' + '${d}')"><h3>📄 ${d.split('/').pop()}</h3><p>${d}</p></div>`).join('');
    } catch(e) {}
}

async function mejorarPrompt() {
    const tipo = document.getElementById('prompt-tipo').value;
    const idea = document.getElementById('prompt-idea').value.trim();
    const log = document.getElementById('prompt-log');
    if(!idea) return alert('Escribe una idea');
    log.innerText = '⏳ Generando prompt...';
    try {
        const r = await fetch('/api/prompt', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({tipo, idea})});
        const d = await r.json();
        log.innerText = d.prompt || d.mensaje || 'Sin respuesta';
    } catch(e) { log.innerText = '❌ ' + e.message; }
}

const _navOrig4 = _nav_orig;
_nav_orig = function(v, el) {
    _navOrig4(v, el);
    if(v === 'analytics') setTimeout(cargarAnalytics, 300);
    if(v === 'docs') setTimeout(cargarDocs, 300);
};

</script>
</body>
</html>
