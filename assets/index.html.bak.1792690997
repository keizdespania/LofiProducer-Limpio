const _navBase = _nav_orig;
_nav_orig = function(v, el) {
    _navBase(v, el);
    if(v === 'musica') setTimeout(() => cargarStudioFiles('musica'), 300);
    if(v === 'imagen') setTimeout(() => cargarStudioFiles('imagen'), 300);
    if(v === 'voz') setTimeout(() => cargarStudioFiles('tts'), 300);
    if(v === 'video') setTimeout(() => cargarStudioFiles('video'), 300);
    if(v === 'media') setTimeout(cargarVault, 300);
    if(v === 'papelera') setTimeout(cargarPapelera, 300);
    if(v === 'canales') setTimeout(cargarCanales, 300);
    if(v === 'produccion') setTimeout(cargarCola, 300);
    if(v === 'especialista') setTimeout(cargarEspecialistas, 300);
    if(v === 'analytics') setTimeout(cargarAnalytics, 300);
    if(v === 'docs') setTimeout(cargarDocs, 300);
};


// ═══ HANDLER DE URL PARAMS (para notificaciones con botón "Abrir") ═══
async function handleUrlParams() {
    const params = new URLSearchParams(window.location.search);
    const view = params.get('view');
    const file = params.get('file');
    const filter = params.get('filter');
    
    if(!view) return;
    
    const navItem = document.querySelector('.nav-item[onclick*="' + view + '"]');
    if(navItem) navItem.click();
    
    await new Promise(r => setTimeout(r, 800));
    
    if(filter) {
        const sel = document.getElementById('vault-filtro');
        if(sel) { sel.value = filter; filtrarVault(); }
    }
    
    if(file) {
        const candidato = (typeof _vaultItems !== 'undefined' ? _vaultItems : []).find(i => i.nombre === file);
        if(candidato) {
            abrirLightbox(candidato.url, candidato.tipo);
        } else {
            abrirLightbox('/media/media_vault/' + file, 'audio');
        }
    }
}


// ═══ MODAL DE PARÁMETROS (Fase 2) ═══
let _mpMotorActual = null;
let _mpContrato = null;
let _mpCallback = null;
let _mpPresetActual = null;

async function abrirModalParams(motor, callback) {
  _mpMotorActual = motor;
  _mpCallback = callback || null;
  _mpPresetActual = null;
  const modal = document.getElementById('modal-params');
  const content = document.getElementById('mp-content');
  const title = document.getElementById('mp-title');
  
  const nombres = {musica: '🎵 Música', voz: '🎙️ Voz', imagen: '🎨 Imagen', video: '🎬 Vídeo'};
  title.innerText = '⚙️ Parámetros · ' + (nombres[motor] || motor);
  content.innerHTML = '<p style="color:var(--muted);">Cargando contrato...</p>';
  modal.classList.add('open');
  
  try {
    const r = await fetch('/api/params/' + motor);
    if (!r.ok) throw new Error('Contrato no disponible');
    _mpContrato = await r.json();
    renderizarParams(motor);
  } catch(e) {
    content.innerHTML = '<p style="color:#ef4444;">Error: ' + e.message + '</p>';
  }
}

function cerrarModalParams() {
  document.getElementById('modal-params').classList.remove('open');
  _mpMotorActual = null;
  _mpContrato = null;
  _mpCallback = null;
}

function renderizarParams(motor) {
  const content = document.getElementById('mp-content');
  const c = _mpContrato;
  let html = '';
  
  // Presets si existen
  if (c.presets) {
    html += '<div class="mp-field"><label class="mp-label">Preset</label>';
    html += '<select class="mp-input" id="mp-preset-select" onchange="aplicarPresetModal(this.value)">';
    html += '<option value="">-- sin preset --</option>';
    for (const [k, v] of Object.entries(c.presets)) {
      html += '<option value="' + k + '">' + k + '</option>';
    }
    html += '</select></div>';
  }
  
  // Bloques
  const ordenBloques = motor === 'imagen' ? ['_'] : ['A','B','C','E'];
  for (const letra of ordenBloques) {
    const bloque = letra === '_' ? null : (c.bloques || {})[letra];
    if (letra !== '_' && (!bloque || !bloque.params || Object.keys(bloque.params).length === 0)) continue;
    
    if (letra === '_') {
      // Imagen: sin bloques, todos los params del validador
      html += renderBloque('Parámetros', 'img_', c.validador?.reglas || [], false);
    } else {
      const abierto = letra === 'A' ? ' open' : '';
      html += '<details class="mp-block"' + abierto + '>';
      html += '<summary>' + letra + ' · ' + (bloque.nombre || letra) + ' (' + Object.keys(bloque.params).length + ' params)</summary>';
      html += '<div class="mp-block-body">';
      for (const [pname, pmeta] of Object.entries(bloque.params)) {
        html += renderCampo(pname, pmeta);
      }
      html += '</div></details>';
    }
  }
  
  content.innerHTML = html;
}

function renderCampo(nombre, meta) {
  const rol = meta.rol || 'fijo';
  const tipo = meta.type || 'string';
  const def = meta.default !== undefined ? meta.default : '';
  const disabled = rol === 'fijo' || rol === 'ajustar_por_modelo' ? ' disabled' : '';
  const lock = disabled ? '<span class="mp-lock">🔒</span>' : '';
  const id = 'mp-field-' + nombre;
  
  let input = '';
  if (meta.rango && Array.isArray(meta.rango) && meta.rango.length === 2) {
    const [min, max] = meta.rango;
    const val = (min + max) / 2;
    input = '<input type="range" class="mp-input" id="' + id + '" min="' + min + '" max="' + max + '" value="' + val + '"' + disabled + ' oninput="document.getElementById(\'' + id + '-val\').innerText=this.value"><span class="mp-val" id="' + id + '-val">' + val + '</span>';
  } else if (meta.valores) {
    input = '<select class="mp-input" id="' + id + '"' + disabled + '>';
    for (const v of meta.valores) input += '<option value="' + v + '">' + v + '</option>';
    input += '</select>';
  } else if (tipo === 'bool') {
    input = '<select class="mp-input" id="' + id + '"' + disabled + '><option value="true">Sí</option><option value="false">No</option></select>';
  } else {
    input = '<input type="text" class="mp-input" id="' + id + '" value="' + def + '"' + disabled + '>';
  }
  
  let html = '<div class="mp-field">';
  html += '<div class="mp-label"><span>' + nombre + ' ' + lock + '</span>' + (meta.rango ? '' : '') + '</div>';
  html += input;
  if (meta.nota) html += '<div class="mp-hint">' + meta.nota + '</div>';
  html += '</div>';
  return html;
}

function aplicarPresetModal(preset) {
  _mpPresetActual = preset;
  if (!preset || !_mpContrato || !_mpContrato.presets) return;
  const p = _mpContrato.presets[preset];
  const params = p.params || {};
  // Rellenar los campos que existan
  for (const [k, v] of Object.entries(params)) {
    const el = document.getElementById('mp-field-' + k);
    if (el) {
      el.value = v;
      const valSpan = document.getElementById('mp-field-' + k + '-val');
      if (valSpan) valSpan.innerText = v;
    }
  }
}

function restaurarPresetActual() {
  if (_mpPresetActual) aplicarPresetModal(_mpPresetActual);
  else renderizarParams(_mpMotorActual);
}

function recogerParams() {
  const result = {};
  const fields = document.querySelectorAll('#mp-content [id^="mp-field-"]');
  fields.forEach(el => {
    const nombre = el.id.replace('mp-field-', '').replace('-val', '');
    if (el.disabled) return;
    let val = el.value;
    if (el.type === 'range') val = parseFloat(val);
    else if (el.tagName === 'SELECT' && val === 'true') val = true;
    else if (el.tagName === 'SELECT' && val === 'false') val = false;
    else if (!isNaN(val) && val !== '') val = parseFloat(val);
    result[nombre] = val;
  });
  return result;
}

async function guardarPresetCustom() {
  const nombre = prompt('Nombre del preset:');
  if (!nombre) return;
  const params = recogerParams();
  try {
    const r = await fetch('/api/user_presets/' + _mpMotorActual, {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({nombre, params})
    });
    const d = await r.json();
    if (d.status === 'ok') alert('✅ ' + d.mensaje);
    else alert('❌ ' + (d.error || 'Error'));
  } catch(e) { alert('❌ ' + e.message); }
}

async function generarConParams() {
  const params = recogerParams();
  if (_mpCallback) {
    _mpCallback(params);
    cerrarModalParams();
  } else {
    alert('ℹ️ Params listos: ' + JSON.stringify(params).substring(0, 200));
  }
}



// ═══ CALLBACK: Generar música con params del modal ═══
async function generarMusicaConParams(params) {
  const prompt = document.getElementById('music-prompt')?.value.trim();
  const dur = parseInt(document.getElementById('music-dur')?.value || 60);
  const log = document.getElementById('music-log');
  if(!prompt) { alert('Escribe un prompt primero'); return; }
  
  // Combinar params del modal con prompt/duration
  const payload = Object.assign({
    prompt: prompt,
    duracion: dur
  }, params);
  
  if(log) log.innerText = '⏳ Enviando con params custom... ' + JSON.stringify(params).substring(0, 100);
  
  try {
    const r = await fetch('/api/generar_musica_acestep', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    const d = await r.json();
    if(log) log.innerText = (d.reply || d.mensaje || '✅ Petición enviada.');
    if(typeof cargarStudioFiles === 'function') cargarStudioFiles('musica');
  } catch(e) {
    if(log) log.innerText = '❌ Error: ' + e.message;
  }
}



// ═══ CALLBACK: Voz con params del modal ═══
async function generarVozConParams(params) {
  const texto = document.getElementById('voz-texto')?.value.trim();
  const voz = document.getElementById('voz-opcion')?.value || 'es_ES-davefx-medium';
  const log = document.getElementById('voz-log');
  if(!texto) { alert('Escribe un texto primero'); return; }
  const payload = Object.assign({texto: texto, voz: voz}, params);
  if(log) log.innerText = '⏳ Generando voz con params custom...';
  try {
    const r = await fetch('/api/voice_studio', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)});
    const d = await r.json();
    if(log) log.innerText = d.status === 'ok' ? '✅ ' + (d.mensaje || 'OK') : '❌ ' + (d.mensaje || 'Error');
    if(typeof cargarStudioFiles === 'function') cargarStudioFiles('tts');
  } catch(e) { if(log) log.innerText = '❌ ' + e.message; }
}

// ═══ CALLBACK: Imagen con params del modal ═══
async function generarImagenConParams(params) {
  const prompt = document.getElementById('img-prompt')?.value.trim();
  const log = document.getElementById('img-log');
  if(!prompt) { alert('Escribe un prompt primero'); return; }
  const payload = Object.assign({prompt: prompt}, params);
  if(log) log.innerText = '⏳ Generando imagen con params custom...';
  try {
    const r = await fetch('/api/generar_imagen', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)});
    const d = await r.json();
    if(log) log.innerText = d.status === 'ok' ? '✅ ' + d.mensaje : '❌ ' + (d.mensaje || 'Error');
    if(typeof cargarStudioFiles === 'function') cargarStudioFiles('imagen');
  } catch(e) { if(log) log.innerText = '❌ ' + e.message; }
}

// ═══ CALLBACK: Vídeo con params del modal ═══




// ═══ VIDEO STUDIO ═══
async function generarVideoWeb() {
    const prompt = document.getElementById('video-prompt')?.value.trim();
    const log = document.getElementById('video-log');
    if(!prompt) { alert('Escribe un prompt'); return; }
    if(log) log.innerText = '⏳ Generando con preset cinematic_480p (~25 min)...';
    try {
        const r = await fetch('/api/generar_video', {method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({prompt: prompt, preset: 'cinematic_480p'})});
        const d = await r.json();
        if(log) log.innerText = (d.status === 'ok' ? '✅ ' : '❌ ') + (d.mensaje || 'Error');
    } catch(e) { if(log) log.innerText = '❌ ' + e.message; }
}

async function generarVideoConParams(params) {
    const prompt = document.getElementById('video-prompt')?.value.trim();
    const log = document.getElementById('video-log');
    if(!prompt) { alert('Escribe un prompt'); return; }
    const payload = Object.assign({prompt: prompt}, params);
    if(log) log.innerText = '⏳ Generando con params custom (~25 min)...';
    try {
        const r = await fetch('/api/generar_video', {method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify(payload)});
        const d = await r.json();
        if(log) log.innerText = (d.status === 'ok' ? '✅ ' : '❌ ') + (d.mensaje || 'Error') + '\nPreset: ' + (d.preset || 'custom') + '\nRes: ' + (d.resolution || '?');
    } catch(e) { if(log) log.innerText = '❌ ' + e.message; }
}



// ═══ CREAR NICHO ═══
async function crearNicho() {
    const nombre = document.getElementById('nicho-nombre')?.value.trim();
    const formato = document.getElementById('nicho-formato')?.value;
    const tono = document.getElementById('nicho-tono')?.value.trim();
    const log = document.getElementById('nicho-log');
    if(!nombre) { alert('Escribe un nombre'); return; }
    
    const plataformas = [];
    if(document.getElementById('plat-youtube')?.checked) plataformas.push('youtube');
    if(document.getElementById('plat-blogger')?.checked) plataformas.push('blogger');
    if(document.getElementById('plat-tiktok')?.checked) plataformas.push('tiktok');
    if(document.getElementById('plat-instagram')?.checked) plataformas.push('instagram');
    
    const payload = {
        nombre: nombre,
        formato: formato,
        tono: tono || 'neutral',
        presets: {
            musica: document.getElementById('preset-musica')?.value,
            voz: document.getElementById('preset-voz')?.value,
            imagen: document.getElementById('preset-imagen')?.value,
            video: document.getElementById('preset-video')?.value,
        },
        pipeline: [],
        plataformas: plataformas,
        cuentas: {
            youtube: document.getElementById('cuenta-youtube')?.value || 'global',
            blogger: document.getElementById('cuenta-blogger')?.value || 'global'
        }
    };
    if(log) log.innerText = '⏳ Creando canal completo...';
    try {
        const r = await fetch('/api/crear_nicho', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)});
        const d = await r.json();
        if(log) {
            if(d.status === 'ok') {
                log.innerText = `✅ ${d.mensaje}\n📁 ${d.canal_dir}\n🎯 Plataformas: ${d.plataformas.join(', ')}\n🔄 SKILL.md: ${d.skill_regenerado ? 'regenerado' : 'error'}`;
            } else {
                log.innerText = '❌ ' + (d.mensaje || 'Error');
            }
        }
        if(d.status === 'ok' && typeof cargarCanales === 'function') cargarCanales();
    } catch(e) { if(log) log.innerText = '❌ ' + e.message; }
}



// ═══ DIRECTOR DE PRODUCCIÓN ═══
function abrirModalProducir() {
    document.getElementById('modal-producir').classList.add('open');
    document.getElementById('producir-input')?.focus();
}

function cerrarModalProducir() {
    document.getElementById('modal-producir').classList.remove('open');
    document.getElementById('producir-informe').innerHTML = '';
}

async function analizarConDios() {
    const input = document.getElementById('producir-input')?.value.trim();
    const cont = document.getElementById('producir-informe');
    if(!input) { alert('Escribe qué quieres producir'); return; }
    if(cont) cont.innerHTML = '<p style="color:var(--muted);">🧠 Dios está analizando... ~3s</p>';

    // Detectar motor (heurística simple)
    let motor = 'musica', preset = 'lofi', nicho = null;
    const low = input.toLowerCase();
    if(low.includes('video') || low.includes('vídeo') || low.includes('clip')) { motor = 'video'; preset = 'cinematic_480p'; }
    else if(low.includes('imagen') || low.includes('foto')) { motor = 'imagen'; preset = 'cinematic'; }
    else if(low.includes('voz') || low.includes('narra')) { motor = 'voz'; preset = 'noticias'; }
    if(low.includes('ia news') || low.includes('ia_news')) nicho = 'ia_news';
    else if(low.includes('lofi')) nicho = 'lofi';
    else if(low.includes('boe')) nicho = 'boe';
    else if(low.includes('finanzas') || low.includes('bolsa')) nicho = 'finanzas_barrio';

    try {
        const r = await fetch('/api/evaluar', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({prompt: input, motor, preset, nicho})
        });
        const d = await r.json();
        if(d.status !== 'ok') { cont.innerHTML = '<p style="color:#ef4444;">❌ ' + (d.mensaje || 'Error') + '</p>'; return; }

        const i = d.informe;
        const plan = `<div style="background:rgba(0,0,0,0.3); border-radius:12px; padding:16px; margin-top:12px;">
            <h3 style="margin-bottom:12px;">${i.veredicto}</h3>
            <p style="color:var(--muted); margin-bottom:12px; font-size:0.9em;">${i.accion}</p>
            <div style="display:grid; gap:8px; font-size:0.85em;">
                <div>${i.coherencia.nivel} <b>Coherencia</b>: ${i.coherencia.motivo}</div>
                <div>${i.presupuesto.nivel} <b>Presupuesto</b>: ${i.presupuesto.motivo}</div>
                <div>${i.calidad.nivel} <b>Calidad prompt</b>: ${i.calidad.motivo}${i.calidad.sugerencia ? ' → ' + i.calidad.sugerencia : ''}</div>
                <div>${i.encaje_nicho.nivel} <b>Encaje nicho</b>: ${i.encaje_nicho.motivo}</div>
            </div>
            ${i.alternativas.length ? `<p style="margin-top:12px; font-size:0.85em; color:var(--muted);">Alternativas: ${i.alternativas.map(a => '<code>'+a+'</code>').join(', ')}</p>` : ''}
            <div style="display:flex; gap:8px; margin-top:16px;">
                <button class="mp-btn mp-btn-primary" onclick="lanzarProduccion('${motor}','${preset}','${input.replace(/'/g, "\\'")}')">✅ Producir</button>
                <button class="mp-btn" onclick="cerrarModalProducir()">❌ Cancelar</button>
            </div>
        </div>`;
        cont.innerHTML = plan;
    } catch(e) { cont.innerHTML = '<p style="color:#ef4444;">❌ ' + e.message + '</p>'; }
}

function lanzarProduccion(motor, preset, prompt) {
    cerrarModalProducir();
    mostrarToast('info', '🎬 Produciendo', motor + ' · preset ' + preset);
    if(motor === 'video' && typeof generarVideoWeb === 'function') {
        document.getElementById('video-prompt') && (document.getElementById('video-prompt').value = prompt);
        generarVideoWeb();
    } else if(motor === 'imagen' && typeof generarImagenWeb === 'function') {
        document.getElementById('img-prompt') && (document.getElementById('img-prompt').value = prompt);
        generarImagenWeb();
    } else if(motor === 'musica' && typeof generarMusicaWeb === 'function') {
        document.getElementById('music-prompt') && (document.getElementById('music-prompt').value = prompt);
        generarMusicaWeb();
    } else if(motor === 'voz' && typeof generarVozWeb === 'function') {
        document.getElementById('voz-texto') && (document.getElementById('voz-texto').value = prompt);
        generarVozWeb();
    }
}

// ═══ PAPELERA CANALES ═══
async function cargarPapeleraCanales() {
    const cont = document.getElementById('lista-papelera-canales');
    if(!cont) return;
    cont.innerHTML = '<p style="color:var(--muted);">Cargando...</p>';
    try {
        const r = await fetch('/api/papelera/listar');
        const items = await r.json();
        if(items.length === 0) {
            cont.innerHTML = '<p style="color:var(--muted);">Papelera vacía.</p>';
            return;
        }
        cont.innerHTML = items.map(c => `<div class="media-card"><h3>📺 ${c.nombre}</h3><p style="font-size:0.75em; color:var(--muted);">Borrado: ${c.borrado} · ${c.dias} días restantes</p><button class="dash-btn" style="margin-top:8px; padding:8px; font-size:0.85em;" onclick="restaurarCanal('${c.id}', '${c.nombre}')">↩️ Restaurar</button></div>`).join('');
    } catch(e) { cont.innerHTML = '<p style="color:#ef4444;">Error: ' + e.message + '</p>'; }
}

async function restaurarCanal(id, nombre) {
    if(!confirm(`¿Restaurar canal "${nombre}"?`)) return;
    try {
        const r = await fetch('/api/papelera/restaurar', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({id})});
        const d = await r.json();
        if(d.status === 'ok') { mostrarToast('success', '✅ Restaurado', d.mensaje); cargarPapeleraCanales(); }
        else { mostrarToast('error', '❌ Error', d.mensaje); }
    } catch(e) { mostrarToast('error', '❌', e.message); }
}

async function borrarCanalTripleFiltro(canalId, nombre) {
    // Filtro 1: modal con info
    const msg = `⚠️ VAS A BORRAR EL CANAL "${nombre}"\n\n` +
                `Esto moverá el canal a la papelera (recuperable 30 días).\n\n` +
                `Para confirmar, escribe el nombre exacto:`;
    const confirm1 = prompt(msg);
    if(confirm1 === null) return;
    if(confirm1.trim() !== canalId) {
        alert('❌ El nombre no coincide. Operación cancelada.');
        return;
    }
    // Filtro 2: confirmación final
    if(!confirm(`¿Seguro? ${nombre} → papelera`)) return;
    try {
        const r = await fetch('/api/papelera/borrar_canal', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({canal_id: canalId, confirm_name: confirm1.trim()})});
        const d = await r.json();
        if(d.status === 'ok') { mostrarToast('success', '🗑️ Movido a papelera', d.mensaje); if(typeof cargarCanales === 'function') cargarCanales(); }
        else { mostrarToast('error', '❌ Error', d.mensaje); }
    } catch(e) { mostrarToast('error', '❌', e.message); }
}

// Hook nav para papelera
const _navPap = _nav_orig;
_nav_orig = function(v, el) {
    _navPap(v, el);
    if(v === 'papelera') setTimeout(cargarPapeleraCanales, 300);
};

</script>

<div id="barra-flotante" class="barra-flotante">
  <span id="contador-sel" style="font-size:0.9em; color:var(--muted);"></span>
  <button class="dash-btn" style="width:auto; padding:8px 16px; background:#ef4444;" onclick="borrarSeleccionados()">🗑️ Borrar</button>
  <button class="dash-btn" style="width:auto; padding:8px 16px; background:rgba(255,255,255,0.1);" onclick="deseleccionarTodos()">✕</button>
</div>


<!-- ═══ MODAL DE PARÁMETROS (Fase 2) ═══ -->
<div id="modal-params" class="mp-overlay">
  <div class="mp-container">
    <div class="mp-header">
      <h2 id="mp-title">⚙️ Parámetros</h2>
      <button class="mp-close" onclick="cerrarModalParams()">✕</button>
    </div>
    <div id="mp-content" class="mp-content">
      <p style="color:var(--muted);">Cargando...</p>
    </div>
    <div class="mp-footer">
      <button class="mp-btn" onclick="restaurarPresetActual()">♻️ Restaurar</button>
      <button class="mp-btn" onclick="guardarPresetCustom()">💾 Guardar</button>
      <button class="mp-btn mp-btn-primary" onclick="generarConParams()">▶️ Generar</button>
    </div>
  </div>
</div>


<!-- ═══ MODAL PRODUCIR (Director de Producción) ═══ -->
<div id="modal-producir" class="mp-overlay">
  <div class="mp-container" style="max-width:720px;">
    <div class="mp-header">
      <h2>🎬 Director de Producción</h2>
      <button class="mp-close" onclick="cerrarModalProducir()">✕</button>
    </div>
    <div class="mp-content">
      <p style="color:var(--muted); margin-bottom:12px;">Dime qué quieres producir. Dios lo analizará antes de gastar GPU.</p>
      <textarea id="producir-input" placeholder="Ej: genera un vídeo de IA News sobre SpaceX con música cinematográfica" style="width:100%; height:100px; padding:12px; background:rgba(0,0,0,0.3); border:1px solid var(--border); border-radius:12px; color:#fff; font-family:var(--font-main); font-size:0.95em; margin-bottom:12px;"></textarea>
      <button class="dash-btn" onclick="analizarConDios()">🧠 Analizar con Dios</button>
      <div id="producir-informe" style="margin-top:20px;"></div>
    </div>
  </div>
</div>

<!-- ═══ VISTA PAPELERA ═══ -->
<div id="view-papelera" class="view">
  <div class="section">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <h2>🗑️ Papelera</h2>
      <button class="dash-btn" style="width:auto; padding:8px 16px;" onclick="cargarPapeleraCanales()">🔄</button>
    </div>
    <p class="desc">Los canales borrados se conservan 30 días. Pasado ese plazo se eliminan.</p>
    <div id="lista-papelera-canales" class="media-grid"><p style="color:var(--muted);">Cargando...</p></div>
  </div>
</div>

</body>
</html>
