function toggleGroup(header) {
    const group = header.parentElement;
    group.classList.toggle('open');
    // Persistir en localStorage
    const groups = JSON.parse(localStorage.getItem('nav_groups') || '{}');
    const idx = Array.from(document.querySelectorAll('.nav-group')).indexOf(group);
    groups[idx] = group.classList.contains('open');
    localStorage.setItem('nav_groups', JSON.stringify(groups));
}

// Restaurar estado al cargar
document.addEventListener('DOMContentLoaded', () => {
    const groups = JSON.parse(localStorage.getItem('nav_groups') || '{}');
    document.querySelectorAll('.nav-group').forEach((g, i) => {
        if(groups[i]) g.classList.add('open');
    });
});


