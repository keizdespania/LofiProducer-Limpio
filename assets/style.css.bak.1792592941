:root { --bg: #000; --surface: #121212; --border: #27272a; --text: #fff; --muted: #a1a1aa; --accent: #3b82f6; --bubble-bot: #1f1f22; --bubble-user: #2563eb; }
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; height: 100dvh; display: flex; flex-direction: column; overflow: hidden; }
header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; height: 56px; z-index: 20; }
.menu-btn { font-size: 1.5em; cursor: pointer; }
.logo-small { font-weight: 600; font-size: 1.1em; display: flex; align-items: center; gap: 8px; }
.logo-small img { height: 24px; }
.sidebar { position: fixed; top: 56px; left: -280px; width: 280px; height: calc(100dvh - 56px); background: var(--surface); border-right: 1px solid var(--border); transition: left 0.3s; z-index: 15; padding: 16px 0; display: flex; flex-direction: column; overflow-y: auto; }
.sidebar.open { left: 0; }
.overlay { position: fixed; top: 56px; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); opacity: 0; pointer-events: none; transition: opacity 0.3s; z-index: 10; }
.overlay.open { opacity: 1; pointer-events: auto; }
.nav-item { padding: 14px 20px; cursor: pointer; color: var(--muted); font-size: 1em; transition: all 0.2s; display: flex; align-items: center; gap: 12px; font-weight: 500; }
.nav-item:hover { color: var(--text); background: rgba(255,255,255,0.05); }
.nav-item.active { color: var(--text); border-left: 3px solid var(--accent); background: rgba(255,255,255,0.05); }
.main { flex: 1; position: relative; overflow-y: auto; }
.view { display: none; height: 100%; }
.view.active { display: flex; flex-direction: column; animation: fadeIn 0.3s; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.home-logo { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 24px; text-align: center; }
.home-logo img { width: 220px; max-width: 80%; filter: drop-shadow(0 0 30px rgba(59,130,246,0.4)); margin-bottom: 20px; }
.home-logo h1 { font-size: 1.8em; font-weight: 600; letter-spacing: -0.5px; }
.home-logo p { color: var(--muted); margin-top: 8px; }
#chat-messages { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 8px; }
.msg { max-width: 85%; padding: 10px 14px; border-radius: 16px; font-size: 0.95em; line-height: 1.5; white-space: pre-wrap; word-wrap: break-word; }
.msg.user { background: var(--bubble-user); color: #fff; align-self: flex-end; border-bottom-right-radius: 4px; }
.msg.assistant { background: var(--bubble-bot); color: var(--text); align-self: flex-start; border-bottom-left-radius: 4px; border: 1px solid var(--border); }
.chat-input-area { padding: 12px 16px 24px 16px; background: var(--surface); border-top: 1px solid var(--border); }
.chat-input-row { display: flex; gap: 8px; background: var(--bg); border: 1px solid var(--border); padding: 4px; border-radius: 24px; }
.chat-input-row input { margin: 0; background: transparent; border: none; color: var(--text); padding: 12px; flex: 1; font-family: inherit; font-size: 16px; }
.chat-input-row input:focus { outline: none; }
.chat-input-row button { background: var(--accent); border: none; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; }
.section { padding: 24px; overflow-y: auto; flex: 1; }
h2 { font-size: 1.2em; font-weight: 600; margin-bottom: 16px; }
input, textarea, select { width: 100%; background: var(--surface); border: 1px solid var(--border); color: var(--text); padding: 14px; border-radius: 10px; font-family: inherit; font-size: 16px; margin-bottom: 12px; }
input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); }
button.btn-primary { background: var(--text); color: var(--bg); border: none; padding: 14px; border-radius: 10px; font-family: inherit; font-size: 0.95em; font-weight: 600; cursor: pointer; width: 100%; margin-bottom: 12px; }
button.btn-primary:hover { opacity: 0.9; }
pre { background: var(--surface); border: 1px solid var(--border); padding: 16px; border-radius: 10px; color: var(--muted); font-family: monospace; white-space: pre-wrap; font-size: 0.85em; overflow-x: auto; }
.media-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
.media-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
.media-card h3 { font-size: 1em; margin-bottom: 8px; color: var(--text); }
.media-list { list-style: none; max-height: 150px; overflow-y: auto; }
.media-list li { padding: 8px 0; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; font-size: 0.85em; cursor: pointer; }
.media-list li:hover { color: var(--accent); }
.media-list li:last-child { border-bottom: none; }
.player-container { margin-top: 12px; }
.player-container audio, .player-container video, .player-container img { width: 100%; border-radius: 8px; max-height: 200px; object-fit: contain; }
#view-analytics .section { display: flex; flex-direction: column; gap: 16px; padding-bottom: 40px; }
.yt-header { font-size: 1.1em; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
.kpi-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }
@media(min-width: 600px) { .kpi-grid { grid-template-columns: 1fr 1fr 1fr; } }
.kpi-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px; position: relative; overflow: hidden; display: flex; flex-direction: column; }
.kpi-card::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: #ff0000; }
.kpi-label { font-size: 0.8em; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
.kpi-value { font-size: 2em; font-weight: 700; color: var(--text); line-height: 1.1; }
.kpi-sub { font-size: 0.75em; color: #2ba640; margin-top: 4px; display: flex; align-items: center; gap: 4px; }
.video-list { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
.video-item { display: flex; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--border); align-items: center; }
.video-item:last-child { border-bottom: none; }
.video-thumb { width: 100px; height: 56px; background: #1f1f22; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--border); }
.video-thumb svg { width: 24px; height: 24px; fill: #ff0000; }
.video-info { flex: 1; min-width: 0; }
.video-title { font-size: 0.9em; font-weight: 500; color: var(--text); margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.video-meta { font-size: 0.75em; color: var(--muted); }
.sys-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.sys-card { background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 10px; padding: 12px; text-align: center; }
.sys-label { font-size: 0.7em; color: var(--muted); text-transform: uppercase; margin-bottom: 4px; }
.sys-value { font-size: 1.1em; font-weight: 600; color: var(--text); }
.sys-value.kaggle { color: #ff0000; }

/* Loader Neón Futurista para el Chat */
.typing-indicator {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 20px;
    padding: 0 4px;
}
.typing-indicator span {
    width: 6px;
    height: 6px;
    background-color: var(--accent);
    border-radius: 50%;
    display: inline-block;
    animation: typing 1.4s infinite ease-in-out both;
}
.typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
.typing-indicator span:nth-child(2) { animation-delay: -0.16s; }
@keyframes typing {
    0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
    40% { transform: scale(1); opacity: 1; box-shadow: 0 0 10px var(--accent); }
}

/* Consola de logs flotante del Dios */
#log-console {
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 600px;
    max-height: 120px;
    background: rgba(0, 0, 0, 0.85);
    border: 1px solid var(--accent);
    border-radius: 8px;
    color: var(--accent);
    font-family: monospace;
    font-size: 0.75em;
    padding: 10px;
    overflow-y: auto;
    display: none;
    z-index: 1000;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
    backdrop-filter: blur(5px);
}
#log-console.active {
    display: block;
    animation: pulse-log 1.5s infinite;
}
@keyframes pulse-log {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; box-shadow: 0 0 25px rgba(59, 130, 246, 0.5); }
}
