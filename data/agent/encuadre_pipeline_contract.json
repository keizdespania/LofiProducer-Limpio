{
  "nombre": "Somos El Encuadre - Pipeline de Producción Automatizada",
  "version": "1.0",
  "fecha_creacion": "2026-10-27",
  "descripcion": "Pipeline completo desde la investigación mediática hasta el renderizado de vídeo y distribución.",
  "fases": {
    "fase_1_consejo_inteligencia": {
      "descripcion": "Análisis forense de medios (prensa, TV, radio, podcasts).",
      "scripts": [
        "scripts/recolector.py",
        "scripts/transcribir_groq.py",
        "scripts/analista_fase1.py",
        "scripts/sintetizador.py"
      ],
      "agentes": [
        "detective_tendencias_v2",
        "forense_medios",
        "abogado_del_diablo",
        "analista_emocional",
        "detector_sesgos_cognitivos",
        "director_inteligencia_v2",
        "guionista_retencion_v2",
        "bibliotecario_v2",
        "verificador_citas"
      ],
      "salida": "output/encuadre/dossier_{fecha}.json"
    },
    "fase_2_fabrica_contenido": {
      "descripcion": "Generación de artículo, guiones, SEO y plan de montaje.",
      "scripts": [
        "scripts/fase2_produccion.py",
        "scripts/preparar_assets.py",
        "scripts/planificador_montaje.py",
        "scripts/generar_blueprint.py",
        "scripts/voz_edge.py"
      ],
      "agentes": [
        "arquitecto_contenido",
        "redactor_blog",
        "guionista_cinematografico",
        "selector_hooks",
        "seo_maestro",
        "disenador_visual",
        "community_manager",
        "analista_rendimiento",
        "director_audiovisual",
        "abogado_legal",
        "dios_ffmpeg"
      ],
      "salida": "output/encuadre/produccion_{fecha}.json"
    },
    "fase_3_renderizado": {
      "descripcion": "Renderizado de vídeo largo y shorts con FFmpeg.",
      "scripts": [
        "scripts/renderizador.py"
      ],
      "assets_necesarios": {
        "imagenes": "web/media/imagenes/*.png",
        "voz_largo": "output/encuadre/voz_largo_{fecha}.mp3",
        "subtitulos_karaoke": "output/encuadre/voz_largo_{fecha}.ass",
        "musica": "output/musica_temp/*.mp3"
      },
      "salida": "output/encuadre/video_largo_{fecha}.mp4 + short_1_{fecha}.mp4"
    }
  },
  "reglas_frodo_aplicadas": [
    "Chunk Chunk Chunk (dividir tareas gigantes)",
    "No dejar agentes huérfanos (cada agente tiene su script)",
    "Reescribir si hay más de 3 parches",
    "Backup antes de tocar"
  ],
  "voz": {
    "motor": "Edge-TTS (Álvaro)",
    "contrato": "data/agent/voice_contract.json"
  }
}