{
  "motor": "Cloudflare SDXL",
  "modelo": "@cf/bytedance/stable-diffusion-xl-lightning",
  "presets": {
    "cinematic": {
      "prompt_extra": "no text, photorealistic",
      "negative": "text, watermark, blurry, cartoon, anime",
      "params": {
        "num_steps": 8,
        "guidance": 8.0,
        "aspect": "16:9"
      }
    },
    "anime": {
      "prompt_extra": "anime style, studio ghibli, vibrant colors, clean lineart, cel shading",
      "negative": "realistic, photo, 3d render, blurry",
      "params": {
        "num_steps": 8,
        "guidance": 7.0,
        "aspect": "16:9"
      }
    },
    "realistic": {
      "prompt_extra": "photorealistic, 8k uhd, dslr, sharp focus, natural lighting",
      "negative": "cartoon, anime, illustration, painting",
      "params": {
        "num_steps": 8,
        "guidance": 7.5,
        "aspect": "16:9"
      }
    },
    "cartoon": {
      "prompt_extra": "pixar style, disney, 3d render, cute, colorful",
      "negative": "realistic, photo, dark, scary",
      "params": {
        "num_steps": 8,
        "guidance": 8.0,
        "aspect": "16:9"
      }
    },
    "product": {
      "prompt_extra": "product photography, studio lighting, white background, commercial",
      "negative": "people, hands, text, watermark",
      "params": {
        "num_steps": 8,
        "guidance": 7.5,
        "aspect": "1:1"
      }
    },
    "portrait": {
      "prompt_extra": "portrait photography, bokeh, 85mm lens, soft light, sharp eyes",
      "negative": "cartoon, anime, multiple people, distorted face",
      "params": {
        "num_steps": 8,
        "guidance": 7.0,
        "aspect": "9:16"
      }
    },
    "landscape": {
      "prompt_extra": "landscape photography, golden hour, wide angle, epic scale",
      "negative": "people, buildings, cartoon, blurry",
      "params": {
        "num_steps": 8,
        "guidance": 7.5,
        "aspect": "16:9"
      }
    },
    "abstract": {
      "prompt_extra": "abstract art, geometric shapes, vibrant colors, conceptual",
      "negative": "realistic, people, faces, text",
      "params": {
        "num_steps": 8,
        "guidance": 8.5,
        "aspect": "1:1"
      }
    }
  },
  "aspect_ratios": {
    "16:9": {
      "width": 1344,
      "height": 768
    },
    "9:16": {
      "width": 768,
      "height": 1344
    },
    "1:1": {
      "width": 1024,
      "height": 1024
    },
    "4:3": {
      "width": 1152,
      "height": 896
    },
    "3:2": {
      "width": 1216,
      "height": 832
    },
    "21:9": {
      "width": 1536,
      "height": 640
    }
  },
  "ejemplos": [
    {
      "input": "un gato en bicicleta",
      "preset": "realistic",
      "params": {
        "prompt": "...",
        "preset": "realistic",
        "aspect": "16:9"
      }
    },
    {
      "input": "portada anime lofi",
      "preset": "anime",
      "params": {
        "prompt": "...",
        "preset": "anime",
        "aspect": "16:9"
      }
    },
    {
      "input": "miniatura finanzas",
      "preset": "cinematic",
      "params": {
        "prompt": "...",
        "preset": "cinematic",
        "aspect": "16:9"
      }
    }
  ],
  "validador": {
    "reglas": [
      {
        "campo": "num_steps",
        "min": 1,
        "max": 20,
        "default": 20
      },
      {
        "campo": "guidance",
        "min": 1.0,
        "max": 15.0,
        "default": 7.5
      },
      {
        "campo": "width",
        "min": 256,
        "max": 1536,
        "default": 1024
      },
      {
        "campo": "height",
        "min": 256,
        "max": 1536,
        "default": 1024
      }
    ]
  },
  "reglas_anti_alucinacion": [
    "Cloudflare SDXL límite 20 num_steps (NO 50)",
    "guidance 7.5 default; <5 no sigue prompt, >12 saturado",
    "Width/height múltiplos de 64",
    "16:9 = 1344x768. 9:16 = 768x1344. 1:1 = 1024x1024",
    "NO poner texto en prompt (SDXL no renderiza texto bien)",
    "preset 'realistic' con 'cartoon' = confusión. Ser coherente",
    "seed=-1 aleatorio, fijo para reproducibilidad",
    "Prompt del usuario PRIMERO, luego prompt_extra",
    "Miniatura YouTube = aspect 16:9 + preset cinematic",
    "Cloudflare límite 10.000 req/día gratis"
  ],
  "modelo_anterior": "@cf/stabilityai/stable-diffusion-xl-base-1.0 (DEPRECADO 2026-11-02: timeout 120s)",
  "notas_2026_11_02": "SDXL Lightning: 4-8 pasos, ~3.7s/imagen vs 120s del base. 33x más rápido. timeout reducido 120→60s. num_steps limitado a 8.",
  "reglas_top1_2026_11_05": [
    "SDXL NO SABE ESCRIBIR TEXTO. Nunca pedir titulares legibles, fechas exactas o letras.",
    "En lugar de texto, usar conceptos visuales: 'red marker', 'blank newspaper', 'circled date'.",
    "Prompts literales y directos (sujeto + acción + entorno). Sin etiquetas de marketing.",
    "El módulo director_fotografia.py traduce el guion a inglés usando Groq 4 (cascada de 4 keys).",
    "Video largo: 16:9 (72 imágenes). Shorts: 9:16 (3 escenas por short). Web: 16:9 (6 imágenes)."
  ]
}