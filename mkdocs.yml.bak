strict: false
site_name: Somos El Encuadre
site_url: https://elencuadre.pages.dev/
site_description: Análisis técnico de cómo los medios construyen tu realidad.

theme:
  custom_dir: overrides
  name: material
  language: es
  logo: assets/images/logo.jpg
  favicon: assets/images/logo.jpg
  palette:
    - scheme: slate
      primary: custom
      accent: custom
      toggle:
        icon: material/brightness-7
        name: Cambiar a modo claro
    - scheme: default
      primary: custom
      accent: custom
      toggle:
        icon: material/brightness-4
        name: Cambiar a modo oscuro
  font:
    text: Inter
    code: JetBrains Mono
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.top
    - navigation.instant
    - navigation.instant.progress
    - navigation.tracking
    - navigation.indexes
    - search.highlight
    - search.suggest
    - search.share
    - content.code.copy
    - content.code.annotate
    - content.tabs.link
    - announce.dismiss

nav:
  - Inicio: index.md
  - Análisis:
    - Índice completo: analisis/index.md
    - Edición 2026-11-23: analisis/2026-11-23/index.md
    - Dossier 2026-11-23: analisis/2026-11-23/dossier.md
    - Ángulo 2026-11-23: analisis/2026-11-23/angulo.md
    - Píldora 2026-11-23: analisis/2026-11-23/pildora.md
    - Edición 2026-11-22: analisis/2026-11-22/index.md
    - Edición 2026-11-21: analisis/2026-11-21/index.md
  - Podcast: podcast/index.md
  - Glosario: glosario.md
  - Método: sobre.md
  - Contacto: contacto.md

hooks:
  - hooks/copy_media.py

plugins:
  - search:
      lang: es
  - minify:
      minify_html: true
  - social:
      enabled: false

use_directory_urls: true

# 2026-11-09: config global web (banner, monetizacion, telegram)
# Para activar monetización: monetizacion_activa: true + adsense_client: 'ca-pub-XXXX'
extra:
  alternate:
    - name: Español
      link: /
      lang: es
    - name: English
      link: /en/
      lang: en
    - name: Français
      link: /fr/
      lang: fr
    - name: Deutsch
      link: /de/
      lang: de
    - name: Português
      link: /pt/
      lang: pt

