            "preset": {"type": "string", "description": "noticias|narracion_relajada|urgente|audiobook|publicidad|tutorial|sintesis_rapida"},
            "length_scale": {"type": "number", "description": "0.5-2.0. <1 más rápido, >1 más lento"},
