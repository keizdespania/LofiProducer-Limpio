@app.route("/api/docs")
def get_docs():
    filename = request.args.get("file", "MANUAL_DE_USO.md")
    if ".." in filename or "/" in filename:
        return jsonify({"error": "Ruta inválida"}), 403
    return send_from_directory(ROOT, filename)


@app.route("/media/<path:filename>")
def serve_media(filename):
    """Sirve archivos estáticos de la carpeta output/ o assets/ con soporte de Range."""
    from flask import send_file, request
    # Buscamos en output/ y assets/ directamente
    for base in [ROOT / "output", ROOT / "assets"]:
        file_path = base / filename
        # Si no existe en la raíz, buscamos recursivamente en subcarpetas
        if not file_path.exists():
            for candidate in base.rglob(filename):
                if candidate.is_file():
                    file_path = candidate
                    break
        if file_path.exists() and file_path.is_file():
            # Detectar el mimetype correcto
            ext = file_path.suffix.lower()
            mimetypes = {
                ".mp4": "video/mp4",
                ".mov": "video/quicktime",
                ".webm": "video/webm",
                ".mp3": "audio/mpeg",
                ".wav": "audio/wav",
                ".png": "image/png",
                ".jpg": "image/jpeg",
                ".jpeg": "image/jpeg",
                ".gif": "image/gif"
            }
            mimetype = mimetypes.get(ext, "application/octet-stream")
            # Usamos send_file con conditional=True para soportar Range
            return send_file(str(file_path), mimetype=mimetype, conditional=True)
    return jsonify({"error": "Archivo no encontrado"}), 404


@app.route("/api/generar_imagen", methods=["POST"])
def generar_imagen_endpoint():
    data = request.json
    prompt = data.get("prompt", "").strip()
    if not prompt:
        return jsonify({"status": "error", "mensaje": "Falta el prompt"})
    
    import subprocess
    try:
        proc = subprocess.run(
            ["python", "scripts/generar_imagen.py", prompt],
            capture_output=True, text=True, cwd=str(ROOT), timeout=120
        )
        if "OK:" in proc.stdout:
            return jsonify({"status": "ok", "reply": proc.stdout.strip()})
        return jsonify({"status": "error", "mensaje": proc.stderr[-300:] or proc.stdout[-300:]})
    except Exception as e:
        return jsonify({"status": "error", "mensaje": str(e)})

